# TECH-G44: scmos.tech; tech drc width/spacing/surround/directional queries, a bad type and no option.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/scmos -noprompt
snap internal
tech drc width m1
tech drc spacing m1
tech drc spacing m1 m2
tech drc surround m2c m1
tech drc direc m2c m1
tech drc surround m1
tech drc width nosuch
tech drc
