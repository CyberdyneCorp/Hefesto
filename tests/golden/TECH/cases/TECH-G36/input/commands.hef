# TECH-G36: box 0 0 3 5 and a tile edge at x=-3; scalegrid 1 2; scalegrid 2 1; scalegrid 2/4, 1:3, 0 2.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
snap internal
load a
box -3 0 3 5
paint metal1
box 0 0 3 5
scalegrid 1 2
box
save a1
scalegrid 2 1
box
save a2
scalegrid 2/4
box
scalegrid 1:3
box
scalegrid 0 2
box
