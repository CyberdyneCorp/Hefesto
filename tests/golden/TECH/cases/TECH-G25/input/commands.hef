# TECH-G25: tiny.tech plus pdc and 'compose pdc pdiff m1': P/E dump of pdc, pdiff, metal1.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
snap internal
load paint_dump
box 0 0 1 1
paint pdc
paint pdc
box 3 0 4 1
paint pdc
paint pdiff
box 6 0 7 1
paint pdc
paint metal1
box 0 3 1 4
paint pdiff
paint pdc
box 3 3 4 4
paint pdiff
paint pdiff
box 6 3 7 4
paint pdiff
paint metal1
box 0 6 1 7
paint metal1
paint pdc
box 3 6 4 7
paint metal1
paint pdiff
box 6 6 7 7
paint metal1
paint metal1
save paint_dump
load erase_dump
box 0 0 1 1
paint pdc
erase pdc
box 3 0 4 1
paint pdc
erase pdiff
box 6 0 7 1
paint pdc
erase metal1
box 0 3 1 4
paint pdiff
erase pdc
box 3 3 4 4
paint pdiff
erase pdiff
box 6 3 7 4
paint pdiff
erase metal1
box 0 6 1 7
paint metal1
erase pdc
box 3 6 4 7
paint metal1
erase pdiff
box 6 6 7 7
paint metal1
erase metal1
save erase_dump
