# TECH-G14: tech layers <x> for prefixes and qualified names.
# Hefesto script (hefesto-cli --diagnostics=magic): each command's result is printed
# on stdout as `puts` prints it in commands.tcl; errors go to stderr.
tech load input/tiny -noprompt
tech layers p
tech layers po
tech layers poly
tech layers polys
tech layers ndif
tech layers m
tech layers cp
tech layers CP
tech layers EP
tech layers f
tech layers pc/metal1
tech layers poly/metal1
