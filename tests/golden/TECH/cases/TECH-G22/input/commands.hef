# TECH-G22: m2c over pc (a); pc,m2c on empty space (b); erase pc,m2c (c).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
snap internal
load a
box 0 0 4 4
paint pc
box 0 0 4 4
paint m2c
save a
load b
box 0 0 4 4
paint pc,m2c
save b
load c
box 0 0 4 4
paint pc,m2c
box 0 0 4 4
erase pc,m2c
save c
