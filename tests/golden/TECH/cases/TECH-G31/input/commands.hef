# TECH-G31: Names with dots, explicit suffix, legacy suffix, missing file.
# Hefesto script (hefesto-cli --diagnostics=magic): each command's result is printed
# on stdout as `puts` prints it in commands.tcl; errors go to stderr.
tech load input/SCN4M_SUBM.20 -noprompt
tech filename
tech load input/tiny.tech -noprompt
tech filename
tech load input/old -noprompt
tech filename
tech load input/nothere -noprompt
tech filename
