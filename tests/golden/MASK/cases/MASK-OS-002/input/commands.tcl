# MASK-OS-002: Variant blocks: layers generated by each variant of style b, through cif see.
proc probe {script} {
    set code [catch {uplevel #0 $script} result]
    puts [list $code $result]
    flush stdout
}
addpath input
if {[catch {
probe {drc off}
probe {tech load input/masktest -noprompt}
probe {snap internal}
probe {load top}
probe {box 0 0 10 4}
probe {paint metal1}
probe {box 0 6 10 10}
probe {paint metal2}
probe {cif ostyle bx}
probe {box 0 0 10 10}
probe {cif see CMF}
probe {feedback save fb_bx_cmf.txt}
probe {feedback clear}
probe {box 0 0 10 10}
probe {cif see CMS}
probe {feedback save fb_bx_cms.txt}
probe {feedback clear}
probe {cif ostyle by}
probe {box 0 0 10 10}
probe {cif see CMF}
probe {feedback save fb_by_cmf.txt}
probe {feedback clear}
probe {box 0 0 10 10}
probe {cif see CMS}
probe {feedback save fb_by_cms.txt}
probe {feedback clear}
} scriptError]} {
    puts [list script-error $scriptError]
    flush stdout
}
quit -noprompt
