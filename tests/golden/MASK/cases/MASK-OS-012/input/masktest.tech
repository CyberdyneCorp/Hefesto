tech
    format 35
    masktest
end

planes
    active,a
    metal1,m1
    metal2,m2
    metal3,m3
end

types
    active  ndiffusion,ndiff
    active  pdiffusion,pdiff
    active  polysilicon,poly
    active  ntransistor,nfet
    metal1  metal1,m1
    metal2  metal2,m2
    metal3  metal3,m3
    active  pdcontact,pdc
    metal1  via1
    metal2  via2
end

contact
    pdc   pdiff  metal1
    via1  metal1 metal2
    via2  metal2 metal3
    stackable via1 via2
end

styles
    styletype mos
end

compose
    compose nfet poly ndiff
end

connect
    metal1 via1
    metal2 via1,via2
    metal3 via2
end

cifoutput
style gds
    scalefactor 10
    layer CMF metal1
        or metal2
        or
        and metal1
        and
        and-not metal3
        and-not
        grow 10
        grow
        grow-grid 5
        grow-grid
        grow-min 10
        grow-min 1 2
        shrink 10
        shrink 1 2
        bloat-or metal1 * 10
        bloat-or metal1
        bloat-max metal1 * 10
        bloat-min metal1 * 10
        bloat-all metal1 metal1
        bloat-all
        squares 10 20 20
        squares 1 2
        squares-grid 10 20 20 0 0
        slots 10 20 20 10 20 20
        slots 1
        close 100
        bridge 5 4
        bridge 5
        bridge-lim 5 4 metal2
        maxrect
        maxrect external
        orthogonal
        orthogonal fill
        not-square
        boundary
        bbox
        bbox top
        net VDD metal1
        tagged A
        mask-hints HVI
        overlapping metal2
        nonoverlapping metal2
        interacting metal2
        noninteracting metal2
        calma 49 0
end

cifinput
style gds
    scalefactor 10
    layer metal1 CMF
        labels CMF
    layer metal2 CMS
        labels CMS
    layer metal3 CMT
    layer poly CPG
        labels CPG
    layer ndiff CAA
    layer nfet CPG
        and CAA
    layer pdc CCA
        grow 10
        and CAA
        and CMF
    calma CMF 49 0
    calma CMS 51 0
    calma CMT 62 0
    calma CPG 46 0
    calma CAA 43 0
    calma CCA 48 0
end

drc
end

extract
end
