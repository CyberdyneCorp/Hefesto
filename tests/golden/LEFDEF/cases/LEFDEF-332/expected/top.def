VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 1000 500 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 1 ;
   - n
      + ROUTED metal1 30  ( 600 15 ) ( 1000 * ) ;
END SPECIALNETS

BLOCKAGES 1 ;
   - LAYER metal1
      RECT ( 0 0 ) ( 500 500 ) ;
END BLOCKAGES

END DESIGN

