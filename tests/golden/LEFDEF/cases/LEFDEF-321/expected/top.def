VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 5800 140 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 20 ;
   - u[0] leaf
      + PLACED ( 0 0 ) N ;
   - u[1] leaf
      + PLACED ( 300 0 ) N ;
   - u[2] leaf
      + PLACED ( 600 0 ) N ;
   - u[3] leaf
      + PLACED ( 900 0 ) N ;
   - u[4] leaf
      + PLACED ( 1200 0 ) N ;
   - u[5] leaf
      + PLACED ( 1500 0 ) N ;
   - u[6] leaf
      + PLACED ( 1800 0 ) N ;
   - u[7] leaf
      + PLACED ( 2100 0 ) N ;
   - u[8] leaf
      + PLACED ( 2400 0 ) N ;
   - u[9] leaf
      + PLACED ( 2700 0 ) N ;
   - u[10] leaf
      + PLACED ( 3000 0 ) N ;
   - u[11] leaf
      + PLACED ( 3300 0 ) N ;
   - u[12] leaf
      + PLACED ( 3600 0 ) N ;
   - u[13] leaf
      + PLACED ( 3900 0 ) N ;
   - u[14] leaf
      + PLACED ( 4200 0 ) N ;
   - u[15] leaf
      + PLACED ( 4500 0 ) N ;
   - u[16] leaf
      + PLACED ( 4800 0 ) N ;
   - u[17] leaf
      + PLACED ( 5100 0 ) N ;
   - u[18] leaf
      + PLACED ( 5400 0 ) N ;
   - u[19] leaf
      + PLACED ( 5700 0 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

NONDEFAULTRULES 1 ;
  - metal1_width_40
     + LAYER metal1 WIDTH 40 ;
END NONDEFAULTRULES

NETS 1 ;
   - bus ( u[19] A ) ( u[18] A ) ( u[17] A ) ( u[16] A ) ( u[15] A )
       ( u[14] A ) ( u[13] A ) ( u[12] A ) ( u[11] A ) ( u[10] A )
       ( u[9] A ) ( u[8] A ) ( u[7] A ) ( u[6] A ) ( u[5] A )
       ( u[4] A ) ( u[3] A ) ( u[2] A ) ( u[1] A ) ( u[0] A )
      + ROUTED metal1 TAPERRULE metal1_width_40  ( 20 120 ) ( 5780 * ) ;
END NETS

END DESIGN

