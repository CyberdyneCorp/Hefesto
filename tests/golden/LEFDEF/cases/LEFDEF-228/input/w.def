VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN w ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
SPECIALNETS 1 ;
- s1 + POLYGON metal1 ( 0 0 ) ( 1000 0 ) ( 1000 1000 ) + ROUTED metal1 100 ( 0 3000 ) ( 1000 3000 ) ;
END SPECIALNETS
NETS 1 ;
- n1 + ROUTED metal1 ( 0 5000 ) ( 1000 5000 ) VIRTUAL ( 2000 5000 ) ( 3000 5000 ) ;
END NETS
END DESIGN
