VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 1000 0 ) ( 3000 500 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 3 ;
   - c_FN child
      + PLACED ( 2750 0 ) FN ;
   - c_S child
      + PLACED ( 1750 400 ) S ;
   - c_N child
      + PLACED ( 1000 0 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

END DESIGN

