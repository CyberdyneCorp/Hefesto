VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2000 1000 ) ;
COMPONENTS 2 ;
- u1 leaf + PLACED ( 0 0 ) N ;
- u2 leaf + PLACED ( 1900 0 ) N ;
END COMPONENTS
PINS 1 ;
- IN + NET IN + DIRECTION INPUT + LAYER metal1 ( -15 -15 ) ( 15 15 ) + PLACED ( 100 515 ) N ;
END PINS
NETS 1 ;
- sig ( u1 A ) ( u2 A ) + ROUTED metal1 ( 0 515 ) ( 2000 515 ) ;
END NETS
END DESIGN
