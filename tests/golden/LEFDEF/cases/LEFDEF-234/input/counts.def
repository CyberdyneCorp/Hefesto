VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN counts ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
VIAS 2 ;
- V12 + RECT metal1 ( -40 -40 ) ( 40 40 ) + RECT via1 ( -20 -20 ) ( 20 20 ) + RECT metal2 ( -40 -40 ) ( 40 40 ) ;
END VIAS
COMPONENTS 3 ;
- u1 inv + PLACED ( 1000 1000 ) N ;
END COMPONENTS
PINS 0 ;
- A + NET A + LAYER metal1 ( -50 -50 ) ( 50 50 ) + PLACED ( 500 500 ) N ;
END PINS
NONDEFAULTRULES 2 ;
- W2 + LAYER metal1 WIDTH 60 ;
END NONDEFAULTRULES
SPECIALNETS 3 ;
- vdd + ROUTED metal1 100 ( 0 9000 ) ( 9000 9000 ) ;
END SPECIALNETS
NETS 5 ;
- n1 + ROUTED metal1 ( 0 3000 ) ( 4000 3000 ) ;
- n2 + ROUTED metal2 ( 5000 0 ) ( 5000 4000 ) ;
END NETS
BLOCKAGES 4 ;
- LAYER metal1 RECT ( 6000 6000 ) ( 7000 7000 ) ;
END BLOCKAGES
END DESIGN
