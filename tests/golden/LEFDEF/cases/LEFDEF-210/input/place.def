VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN place ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
COMPONENTS 8 ;
- uN inv + PLACED ( 1000 2000 ) N ;
- uS inv + PLACED ( 1000 2000 ) S ;
- uE inv + PLACED ( 1000 2000 ) E ;
- uW inv + PLACED ( 1000 2000 ) W ;
- uFN inv + PLACED ( 1000 2000 ) FN ;
- uFS inv + PLACED ( 1000 2000 ) FS ;
- uFE inv + PLACED ( 1000 2000 ) FE ;
- uFW inv + PLACED ( 1000 2000 ) FW ;
END COMPONENTS
END DESIGN
