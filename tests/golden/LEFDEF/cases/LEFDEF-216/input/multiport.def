VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN multiport ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
PINS 2 ;
- VDD + NET VDD + SPECIAL + DIRECTION INOUT + USE POWER
  + PORT + LAYER metal1 ( -100 -50 ) ( 100 50 ) + PLACED ( 1000 1000 ) N
  + PORT + LAYER metal1 ( -100 -50 ) ( 100 50 ) + PLACED ( 1000 5000 ) N ;
- A + NET A + DIRECTION INPUT + LAYER metal1 ( -50 -50 ) ( 50 50 ) + PLACED ( 3000 3000 ) N ;
END PINS
END DESIGN
