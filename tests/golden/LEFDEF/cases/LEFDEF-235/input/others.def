VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN others ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
ROW ROW_0 core 0 0 N DO 10 BY 1 STEP 200 0 ;
TRACKS X 50 DO 20 STEP 100 LAYER metal1 ;
GCELLGRID X 0 DO 5 STEP 2000 ;
BEGINEXT "tag"
  CREATOR "nobody" ;
ENDEXT
FILLS 1 ;
- LAYER metal1 RECT ( 100 100 ) ( 200 200 ) ;
END FILLS
GROUPS 1 ;
- g1 u1 ;
END GROUPS
NETS 1 ;
- n1 + ROUTED metal1 ( 0 3000 ) ( 4000 3000 ) ;
END NETS
END DESIGN
