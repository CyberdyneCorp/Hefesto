VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN v ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
VIAS 1 ;
- VG + VIARULE M1M2gen + CUTSIZE 40 40 + LAYERS metal1 via1 metal2 + CUTSPACING 40 40
    + ENCLOSURE 10 10 20 20 + ROWCOL 3 2 ;
END VIAS
NETS 1 ;
- n1 + ROUTED metal1 ( 0 500 ) ( 1000 500 ) VG NEW metal2 ( 1000 500 ) ( 1000 3000 ) ;
END NETS
END DESIGN
