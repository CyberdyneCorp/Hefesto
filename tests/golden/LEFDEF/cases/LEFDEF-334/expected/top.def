VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 1200 600 ) ;

VIAS 2 ;
   - via2_40_40
      + RECT metal2 ( -20 -20 ) ( 20 20 )
      + RECT metal3 ( -20 -20 ) ( 20 20 )
      + RECT via2 ( -18 -18 ) ( -14 -14 )
      + RECT via2 ( -10 -18 ) ( -6 -14 )
      + RECT via2 ( -2 -18 ) ( 2 -14 )
      + RECT via2 ( 6 -18 ) ( 10 -14 )
      + RECT via2 ( 14 -18 ) ( 18 -14 )
      + RECT via2 ( -18 -10 ) ( -14 -6 )
      + RECT via2 ( -10 -10 ) ( -6 -6 )
      + RECT via2 ( -2 -10 ) ( 2 -6 )
      + RECT via2 ( 6 -10 ) ( 10 -6 )
      + RECT via2 ( 14 -10 ) ( 18 -6 )
      + RECT via2 ( -18 -2 ) ( -14 2 )
      + RECT via2 ( -10 -2 ) ( -6 2 )
      + RECT via2 ( -2 -2 ) ( 2 2 )
      + RECT via2 ( 6 -2 ) ( 10 2 )
      + RECT via2 ( 14 -2 ) ( 18 2 )
      + RECT via2 ( -18 6 ) ( -14 10 )
      + RECT via2 ( -10 6 ) ( -6 10 )
      + RECT via2 ( -2 6 ) ( 2 10 )
      + RECT via2 ( 6 6 ) ( 10 10 )
      + RECT via2 ( 14 6 ) ( 18 10 )
      + RECT via2 ( -18 14 ) ( -14 18 )
      + RECT via2 ( -10 14 ) ( -6 18 )
      + RECT via2 ( -2 14 ) ( 2 18 )
      + RECT via2 ( 6 14 ) ( 10 18 )
      + RECT via2 ( 14 14 ) ( 18 18 ) ;
   - via1_40_40
      + RECT metal1 ( -20 -20 ) ( 20 20 )
      + RECT metal2 ( -20 -20 ) ( 20 20 )
      + RECT via1 ( -18 -18 ) ( -14 -14 )
      + RECT via1 ( -10 -18 ) ( -6 -14 )
      + RECT via1 ( -2 -18 ) ( 2 -14 )
      + RECT via1 ( 6 -18 ) ( 10 -14 )
      + RECT via1 ( 14 -18 ) ( 18 -14 )
      + RECT via1 ( -18 -10 ) ( -14 -6 )
      + RECT via1 ( -10 -10 ) ( -6 -6 )
      + RECT via1 ( -2 -10 ) ( 2 -6 )
      + RECT via1 ( 6 -10 ) ( 10 -6 )
      + RECT via1 ( 14 -10 ) ( 18 -6 )
      + RECT via1 ( -18 -2 ) ( -14 2 )
      + RECT via1 ( -10 -2 ) ( -6 2 )
      + RECT via1 ( -2 -2 ) ( 2 2 )
      + RECT via1 ( 6 -2 ) ( 10 2 )
      + RECT via1 ( 14 -2 ) ( 18 2 )
      + RECT via1 ( -18 6 ) ( -14 10 )
      + RECT via1 ( -10 6 ) ( -6 10 )
      + RECT via1 ( -2 6 ) ( 2 10 )
      + RECT via1 ( 6 6 ) ( 10 10 )
      + RECT via1 ( 14 6 ) ( 18 10 )
      + RECT via1 ( -18 14 ) ( -14 18 )
      + RECT via1 ( -10 14 ) ( -6 18 )
      + RECT via1 ( -2 14 ) ( 2 18 )
      + RECT via1 ( 6 14 ) ( 10 18 )
      + RECT via1 ( 14 14 ) ( 18 18 ) ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 4 ;
   - d
      + ROUTED metal2 40  ( 340 420 ) ( 620 * ) via2_40_40 
      NEW metal3 50  ( 640 425 ) ( 900 * ) ;
   - a
      + ROUTED metal1 40  ( 0 20 ) ( 320 * ) via1_40_40 
      NEW metal2 40  ( 340 20 ) ( 600 * ) ;
   - b
      + ROUTED metal1 40  ( 0 220 ) ( 320 * ) via1_40_40 
      NEW metal2 40  ( 340 220 ) ( 600 * ) ;
   - c
      + ROUTED metal1 40  ( 0 420 ) ( 300 * ) ;
END SPECIALNETS

BLOCKAGES 2 ;
   - LAYER metal1
      RECT ( 1000 0 ) ( 1200 200 ) ;
   - LAYER metal2
      RECT ( 1000 400 ) ( 1200 600 ) ;
END BLOCKAGES

END DESIGN

