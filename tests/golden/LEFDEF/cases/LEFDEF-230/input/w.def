VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN w ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
SPECIALNETS 3 ;
- s1 + ROUTED metal1 100 ( 0 0 ) ( 1000 0 ) + SHAPE STRIPE ( 1000 1000 ) ;
- s2 + ROUTED metal1 100 ( 0 2000 ) ( 1000 2000 ) + MASK 1 ;
- s3 + ROUTED metal1 100 ( 0 4000 ) ( 1000 4000 ) ;
END SPECIALNETS
END DESIGN
