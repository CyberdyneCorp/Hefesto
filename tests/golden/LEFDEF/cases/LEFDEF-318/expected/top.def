VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 1000 ) ( 2000 2000 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 1 ;
   - A + NET A
     + DIRECTION INPUT
     + USE SIGNAL
     + PORT
        + LAYER metal1 ( -300 -50 ) ( 300 50 )        + PLACED ( 300 1050 ) N ;
END PINS

SPECIALNETS 3 ;
   - A ( PIN A )
      + ROUTED metal1 100  ( 0 1050 ) ( 600 * ) ;
   - clkint
      + ROUTED metal1 100  ( 1000 1050 ) ( 1600 * ) ;
   - vdd!
      + ROUTED metal1 100  ( 0 1950 ) ( 2000 * ) ;
END SPECIALNETS

END DESIGN

