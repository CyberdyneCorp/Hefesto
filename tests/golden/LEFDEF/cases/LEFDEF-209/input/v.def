VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN v ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
VIAS 1 ;
- M1M2 + RECT metal1 ( -40 -40 ) ( 40 40 ) + RECT via1 ( -20 -20 ) ( 20 20 ) + RECT metal2 ( -40 -40 ) ( 40 40 ) ;
END VIAS
NETS 1 ;
- n1 + ROUTED metal1 ( 0 500 ) ( 1000 500 ) M1M2 NEW metal2 ( 1000 500 ) ( 1000 3000 ) ;
END NETS
END DESIGN
