# LEFDEF-STARTUP-lef: magic -T input/lefdef input/cells.lef, commands on standard input: the LEF macros read at startup (the cells listed and saved).
proc probe {script} {
    set code [catch {uplevel #0 $script} result]
    puts [list $code $result]
    flush stdout
}
addpath input
if {[catch {
probe {drc off}
probe {cellname list allcells}
probe {writeall force}
} scriptError]} {
    puts [list script-error $scriptError]
    flush stdout
}
quit -noprompt
