VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 900 400 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 1 ;
   - f
      + ROUTED metal1 30  ( 0 15 ) ( 500 * ) ;
END SPECIALNETS

BLOCKAGES 3 ;
   - LAYER metal1
      RECT ( 0 200 ) ( 300 400 ) ;
   - LAYER metal2
      RECT ( 400 200 ) ( 700 400 ) ;
   - LAYER via1
      RECT ( 800 200 ) ( 900 300 ) ;
END BLOCKAGES

END DESIGN

