VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 1000 2500 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 4 ;
   - nl
      + ROUTED metal1 30  ( 0 15 ) ( 500 * )
      NEW metal1 30  ( 485 30 ) ( * 500 ) ;
   - nd_uq0
      + ROUTED metal1 30  ( 600 1015 ) ( 1000 * ) ;
   - nd
      + ROUTED metal1 30  ( 0 1015 ) ( 400 * ) ;
   - ng
      + ROUTED metal1 30  ( 0 2015 ) ( 500 * )
      NEW metal1 30  ( 485 2030 ) ( * 2470 )
      NEW metal1 30  ( 470 2485 ) ( 1000 * ) ;
END SPECIALNETS

END DESIGN

