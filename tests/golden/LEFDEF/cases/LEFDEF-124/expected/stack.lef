VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO stack
  CLASS BLOCK ;
  FOREIGN stack ;
  ORIGIN 0.000 -327.640 ;
  SIZE 0.000 BY -1.400 ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal1 ;
        RECT 0.000 0.000 0.400 0.100 ;
      LAYER via1 ;
        RECT 0.300 0.000 0.400 0.100 ;
      LAYER metal2 ;
        RECT 0.300 0.000 0.800 0.100 ;
    END
  END A
END stack
END LIBRARY

