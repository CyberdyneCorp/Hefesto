VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 900 0 ) ( 1000 200 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 1 ;
   - c_R child
      + PLACED ( 900 0 ) W ;
END COMPONENTS

PINS 0 ;
END PINS

END DESIGN

