VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN w ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
NONDEFAULTRULES 1 ;
- W2 + LAYER met1 WIDTH 280 ;
END NONDEFAULTRULES
NETS 2 ;
- n1 + NONDEFAULTRULE W2 + ROUTED metal1 ( 0 0 ) ( 2000 0 ) ;
- n2 + ROUTED metal1 ( 0 1000 ) ( 2000 1000 ) + NONDEFAULTRULE W2 ;
END NETS
END DESIGN
