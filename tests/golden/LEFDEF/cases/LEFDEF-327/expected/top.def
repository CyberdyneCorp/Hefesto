VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 6000 1000 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 1 ;
   - vdd!
      + ROUTED metal1 100  ( 0 50 ) ( 6000 * )
      NEW metal1 100  ( 50 100 ) ( * 1000 )
      NEW metal1 100  ( 550 100 ) ( * 1000 )
      NEW metal1 100  ( 1050 100 ) ( * 1000 )
      NEW metal1 100  ( 1550 100 ) ( * 1000 )
      NEW metal1 100  ( 2050 100 ) ( * 1000 )
      NEW metal1 100  ( 2550 100 ) ( * 1000 )
      NEW metal1 100  ( 3050 100 ) ( * 1000 )
      NEW metal1 100  ( 3550 100 ) ( * 1000 )
      NEW metal1 100  ( 4050 100 ) ( * 1000 )
      NEW metal1 100  ( 4550 100 ) ( * 1000 )
      NEW metal1 100  ( 5050 100 ) ( * 1000 )
      NEW metal1 100  ( 5550 100 ) ( * 1000 ) ;
END SPECIALNETS

END DESIGN

