VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN c1 ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 1000 1080 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 1 ;
   - c2_0 c2
      + PLACED ( 0 0 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 1 ;
   - w
      + ROUTED metal1 80  ( 0 1040 ) ( 1000 * ) ;
END SPECIALNETS

END DESIGN

