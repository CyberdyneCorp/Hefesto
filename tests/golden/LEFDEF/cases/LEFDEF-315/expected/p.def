VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN p ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 12000 3000 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 10 ;
   - I + NET I
     + DIRECTION INPUT
     + USE SIGNAL
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 1000 1000 ) N ;
   - O + NET O
     + DIRECTION OUTPUT
     + USE ANALOG
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 2000 1000 ) N ;
   - T + NET T
     + DIRECTION OUTPUT
     + USE CLOCK
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 3000 1000 ) N ;
   - B + NET B
     + DIRECTION INOUT
     + USE POWER
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 4000 1000 ) N ;
   - F + NET F
     + DIRECTION FEEDTHRU
     + USE GROUND
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 5000 1000 ) N ;
   - R + NET R
     + DIRECTION INPUT
     + USE 
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 6000 1000 ) N ;
   - S + NET S
     + DIRECTION INPUT
     + USE 
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 7000 1000 ) N ;
   - Z + NET Z
     + DIRECTION OUTPUT
     + USE 
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 8000 1000 ) N ;
   - D + NET D
     + DIRECTION OUTPUT
     + USE 
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 9000 1000 ) N ;
   - E + NET E
     + DIRECTION INPUT
     + USE 
     + PORT
        + LAYER metal1 ( -50 -50 ) ( 50 50 )        + PLACED ( 10000 1000 ) N ;
END PINS

END DESIGN

