VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 200 100 ) ;

VIAS 1 ;
   - via2_40_40
      + RECT metal2 ( -20 -20 ) ( 20 20 )
      + RECT metal3 ( -20 -20 ) ( 20 20 )
      + RECT via2 ( -18 -18 ) ( -14 -14 )
      + RECT via2 ( -10 -18 ) ( -6 -14 )
      + RECT via2 ( -2 -18 ) ( 2 -14 )
      + RECT via2 ( 6 -18 ) ( 10 -14 )
      + RECT via2 ( 14 -18 ) ( 18 -14 )
      + RECT via2 ( -18 -10 ) ( -14 -6 )
      + RECT via2 ( -10 -10 ) ( -6 -6 )
      + RECT via2 ( -2 -10 ) ( 2 -6 )
      + RECT via2 ( 6 -10 ) ( 10 -6 )
      + RECT via2 ( 14 -10 ) ( 18 -6 )
      + RECT via2 ( -18 -2 ) ( -14 2 )
      + RECT via2 ( -10 -2 ) ( -6 2 )
      + RECT via2 ( -2 -2 ) ( 2 2 )
      + RECT via2 ( 6 -2 ) ( 10 2 )
      + RECT via2 ( 14 -2 ) ( 18 2 )
      + RECT via2 ( -18 6 ) ( -14 10 )
      + RECT via2 ( -10 6 ) ( -6 10 )
      + RECT via2 ( -2 6 ) ( 2 10 )
      + RECT via2 ( 6 6 ) ( 10 10 )
      + RECT via2 ( 14 6 ) ( 18 10 )
      + RECT via2 ( -18 14 ) ( -14 18 )
      + RECT via2 ( -10 14 ) ( -6 18 )
      + RECT via2 ( -2 14 ) ( 2 18 )
      + RECT via2 ( 6 14 ) ( 10 18 )
      + RECT via2 ( 14 14 ) ( 18 18 ) ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

END DESIGN

