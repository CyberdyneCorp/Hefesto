VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN w ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
NONDEFAULTRULES 1 ;
- W2 + LAYER metal1 WIDTH 280 ;
END NONDEFAULTRULES
NETS 1 ;
- n1 + NONDEFAULTRULE W2 + ROUTED metal1 ( 0 0 ) ( 1000 0 ) TAPER ( 2000 0 )
    NEW metal1 TAPERRULE W2 ( 0 1000 ) ( 2000 1000 )
    NEW metal1 TAPERRULE DEFAULT ( 0 2000 ) ( 2000 2000 ) ;
END NETS
END DESIGN
