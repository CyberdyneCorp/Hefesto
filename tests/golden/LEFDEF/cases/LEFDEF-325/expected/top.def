VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN top ;
   TECHNOLOGY lefdef ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( 0 0 ) ( 1000 260 ) ;

VIAS 1 ;
   - via1_40_40
      + RECT metal1 ( -20 -20 ) ( 20 20 )
      + RECT metal2 ( -20 -20 ) ( 20 20 )
      + RECT via1 ( -18 -18 ) ( -14 -14 )
      + RECT via1 ( -10 -18 ) ( -6 -14 )
      + RECT via1 ( -2 -18 ) ( 2 -14 )
      + RECT via1 ( 6 -18 ) ( 10 -14 )
      + RECT via1 ( 14 -18 ) ( 18 -14 )
      + RECT via1 ( -18 -10 ) ( -14 -6 )
      + RECT via1 ( -10 -10 ) ( -6 -6 )
      + RECT via1 ( -2 -10 ) ( 2 -6 )
      + RECT via1 ( 6 -10 ) ( 10 -6 )
      + RECT via1 ( 14 -10 ) ( 18 -6 )
      + RECT via1 ( -18 -2 ) ( -14 2 )
      + RECT via1 ( -10 -2 ) ( -6 2 )
      + RECT via1 ( -2 -2 ) ( 2 2 )
      + RECT via1 ( 6 -2 ) ( 10 2 )
      + RECT via1 ( 14 -2 ) ( 18 2 )
      + RECT via1 ( -18 6 ) ( -14 10 )
      + RECT via1 ( -10 6 ) ( -6 10 )
      + RECT via1 ( -2 6 ) ( 2 10 )
      + RECT via1 ( 6 6 ) ( 10 10 )
      + RECT via1 ( 14 6 ) ( 18 10 )
      + RECT via1 ( -18 14 ) ( -14 18 )
      + RECT via1 ( -10 14 ) ( -6 18 )
      + RECT via1 ( -2 14 ) ( 2 18 )
      + RECT via1 ( 6 14 ) ( 10 18 )
      + RECT via1 ( 14 14 ) ( 18 18 ) ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 2 ;
   - n1
      + ROUTED metal1 40  ( 0 20 ) ( 520 * ) via1_40_40 
      NEW metal2 40  ( 540 20 ) ( 1000 * ) ;
   - n2
      + ROUTED metal1 60  ( 0 230 ) ( 500 * )
      NEW metal1 40  ( 520 220 ) via1_40_40 
      NEW metal2 40  ( 540 220 ) ( 1000 * ) ;
END SPECIALNETS

END DESIGN

