VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN inherit ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
PINS 2 ;
- P + NET P + DIRECTION OUTPUT + USE POWER + LAYER metal1 ( -50 -50 ) ( 50 50 ) + PLACED ( 1000 1000 ) N ;
- Q + NET Q + LAYER metal1 ( -50 -50 ) ( 50 50 ) + PLACED ( 3000 1000 ) N ;
END PINS
END DESIGN
