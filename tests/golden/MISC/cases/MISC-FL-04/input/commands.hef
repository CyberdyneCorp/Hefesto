setlabel font FreeSans.pt3 0.58
setlabel fontlist
setlabel font 1
setlabel font -1
setlabel font 9
setlabel font nosuch.pt3
setlabel -default font
setlabel -default justify
setlabel -default font FreeMono
setlabel -default rotate 45
setlabel -default justify ne
setlabel -default font
setlabel -default rotate
setlabel -default justify
setlabel nosuch
setlabel
load a
box 0 0 10 10
