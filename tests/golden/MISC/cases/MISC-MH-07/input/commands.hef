# MISC-MH-07: Child with a hint placed with rotation 90; flatten into a new cell; flatten -doinplace the instance.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/t -noprompt
snap internal
drc off
load child
box 0 0 10 4
paint m1
property MASKHINTS_X 0 0 6 4
save child
load top
box 20 0 20 0
getcell child 90
save top
load top
flatten flat
load flat
save flat
property MASKHINTS_X
load top
flatten -doinplace child_0
property MASKHINTS_X
save top
