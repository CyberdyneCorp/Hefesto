# plottest.tech -- the test technology of the MISC-PLOT cases (tests/golden/MISC/CASES.md,
# openspec/changes/m10-plot-route design D19, task 2.4).
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 The Hefesto Authors
# The PDKs have only `style pnm`, so the PostScript cases use this minimal Hefesto-authored technology
# with both a `style postscript` and a `style pnm` block. Planes well, active, metal1, metal2; two
# contacts (pc: poly/metal1, m2c: metal1/metal2); display styles from Magic's `mos` set (the -dnull
# display loads mos.7bit.dstyle). The authoring script (m10_cases.py) copies this file into each case's
# input/ and replaces the plot section (between the `plot` and `end` lines) where a case needs another.
tech
    format 35
    plottest
end

version
    version 1
    description "Hefesto MISC-PLOT test technology"
end

planes
    well,w
    active,a
    metal1,m1
    metal2,m2
end

types
    well    nwell,nw
    active  polysilicon,poly
    active  ndiffusion,ndiff
    active  polycontact,pc
    metal1  metal1,m1
    metal2  metal2,m2
    metal1  m2contact,m2c
end

contact
    pc   poly   metal1
    m2c  metal1 metal2
end

styles
    styletype mos
    nwell  12
    poly   1
    ndiff  2
    pc     26
    pc     32
    m1     20
    m2     21
    m2c    20
    m2c    21
    m2c    32
end

compose
end

connect
    poly,pc  poly,pc
    m1,pc,m2c  m1,pc,m2c
    m2,m2c   m2,m2c
end

cifoutput
end

cifinput
end

drc
end

extract
end

plot
    style postscript
	 1 C0C0C0C0 C0C0C0C0 00000000 00000000 0C0C0C0C 0C0C0C0C 00000000 00000000
	 5 FFFFFFFF FFFFFFFF FFFFFFFF FFFFFFFF FFFFFFFF FFFFFFFF FFFFFFFF FFFFFFFF
	 7 18181818 30303030 60606060 C0C0C0C0 81818181 03030303 06060606 0C0C0C0C
	 9 223  47 223   0
	10   0   0   0 255
	12 191 127   0   0
	13  95 223  63   0
	14   0   0   0 255
	pc,m2c        14  X
	m2,m2c        13  7
	m1,pc,m2c     10  S
	poly,pc       12  5
	ndiff          9  1
	nwell         13  B
    style pnm
	default
end
