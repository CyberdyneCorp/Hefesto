tech
    format 35
    masktest
end

planes
    active,a
    metal1,m1
    metal2,m2
    metal3,m3
end

types
    active  ndiffusion,ndiff
    active  pdiffusion,pdiff
    active  polysilicon,poly
    active  ntransistor,nfet
    metal1  metal1,m1
    metal2  metal2,m2
    metal3  metal3,m3
    active  pdcontact,pdc
    metal1  via1
    metal2  via2
end

contact
    pdc   pdiff  metal1
    via1  metal1 metal2
    via2  metal2 metal3
    stackable via1 via2
end

styles
    styletype mos
end

compose
    compose nfet poly ndiff
end

connect
    metal1 via1
    metal2 via1,via2
    metal3 via2
end

cifoutput
style gds
    scalefactor 10
    layer MET1
        bloat-or metal1 * 0
        mask-hints MET1
        calma 49 0
end

cifinput
style gds
    scalefactor 10
    layer metal1 MET1
        and M1A
    calma MET1 49 0
    calma M1A 49 1
end

drc
end

extract
end
