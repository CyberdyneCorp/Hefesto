# EX-050: areacap metal2 10, overlap metal2 metal1 20; a parent metal2 wire p crossing child c1's metal1 wire a: the hierarchical cap record
proc probe {script} {
    set code [catch {uplevel #0 $script} result]
    puts [list $code $result]
    flush stdout
}
addpath input
if {[catch {
tech load input/exttest -noprompt
drc off
load ex
box 0 0 1 1
probe {extract all}
} scriptError]} {
    puts [list script-error $scriptError]
    flush stdout
}
quit -noprompt
