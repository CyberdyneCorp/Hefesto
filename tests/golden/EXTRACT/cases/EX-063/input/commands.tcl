# EX-063: defaultareacap, defaultperimeter and defaultsideoverlap with substrate *psd,space,pwell well (default type pwell): the caps on a metal1/metal2 layout
proc probe {script} {
    set code [catch {uplevel #0 $script} result]
    puts [list $code $result]
    flush stdout
}
addpath input
if {[catch {
tech load input/exttest -noprompt
drc off
load ex
box 0 0 1 1
probe {extract all}
} scriptError]} {
    puts [list script-error $scriptError]
    flush stdout
}
quit -noprompt
