# CORE-HASH-01: iteration order of a Magic string hash table.
# Capability hefesto-output-determinism, requirement "Magic string hash table".
# One command per line; see tools/golden/harness/magic_hash/driver.c for the syntax.
# Scenario "Insertion history decides the order": expect u1 u2 u3
hefesto::debug::hashorder 32 +u3 +u1 +u2
# Scenario "Same bucket, most recent first": expect b a
hefesto::debug::hashorder 32 +a +b
# Scenario "Hash of a short key" (bucket 1) plus neighbours
hefesto::debug::hashorder 32 +ab +ba +aa +bb
# Size rounding: requested 5 -> 8 buckets; requested 1 -> 2 buckets
hefesto::debug::hashorder 5 +x +y +z +w +v
hefesto::debug::hashorder 1 +x +y +z
# Growth at 3 x size: 2 buckets grow to 8 on the 7th insert
hefesto::debug::hashorder 2 +k0 +k1 +k2 +k3 +k4 +k5 +k6
# Growth at 3 x size: 32 buckets grow to 128 on the 97th insert
hefesto::debug::hashorder 32 +n0 +n1 +n2 +n3 +n4 +n5 +n6 +n7 +n8 +n9 +n10 +n11 +n12 +n13 +n14 +n15 +n16 +n17 +n18 +n19 +n20 +n21 +n22 +n23 +n24 +n25 +n26 +n27 +n28 +n29 +n30 +n31 +n32 +n33 +n34 +n35 +n36 +n37 +n38 +n39 +n40 +n41 +n42 +n43 +n44 +n45 +n46 +n47 +n48 +n49 +n50 +n51 +n52 +n53 +n54 +n55 +n56 +n57 +n58 +n59 +n60 +n61 +n62 +n63 +n64 +n65 +n66 +n67 +n68 +n69 +n70 +n71 +n72 +n73 +n74 +n75 +n76 +n77 +n78 +n79 +n80 +n81 +n82 +n83 +n84 +n85 +n86 +n87 +n88 +n89 +n90 +n91 +n92 +n93 +n94 +n95 +n96
# Signed key bytes (UTF-8 bytes >= 0x80 are negative)
hefesto::debug::hashorder 32 +é +ü +ñ +aç +Åx +z
# Removal keeps the relative order; duplicate insert and missing removal are no-ops
hefesto::debug::hashorder 32 +k1 +k2 +k3 +k4 -k2 +k5 +k1 -nosuch
# Removal does not lower the growth count: 6 inserts, 1 removal, then growth on the 7th insert
hefesto::debug::hashorder 2 +r0 +r1 +r2 +r3 +r4 +r5 -r0 +r6
