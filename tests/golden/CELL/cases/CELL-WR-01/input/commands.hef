# CELL-WR-01: scmos: poly, metal1, a triangle and two instances; save.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/scmos -noprompt
snap internal
load leaf
box 0 0 10 10
paint metal1
save leaf
load top
box 0 0 4 20
paint poly
box 10 0 30 6
paint metal1
box 40 0 50 10
splitpaint nw metal1
box 100 0 100 0
getcell leaf
box 200 0 200 0
getcell leaf 90
save top
