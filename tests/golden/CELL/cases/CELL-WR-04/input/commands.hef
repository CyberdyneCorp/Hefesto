# CELL-WR-04: metal1 A, B and a 4-rect staircase: record order.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/scmos -noprompt
snap internal
load a
box 0 0 10 10
paint metal1
box 20 5 30 15
paint metal1
box 40 0 44 4
paint metal1
box 42 4 46 8
paint metal1
box 44 8 48 12
paint metal1
box 46 12 50 16
paint metal1
save a
