# CELL-TS-02: Edit leaf alone and save it; then load top (timestamp mismatch processing and the DRC check areas it leaves); save top.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/scmos -noprompt
snap internal
drc off
load input/leaf
box 10 0 14 4
paint metal1
save
load input/top
select top cell
expand
cellname flags leaf
cellname flags mid
cellname flags top
writeall force
