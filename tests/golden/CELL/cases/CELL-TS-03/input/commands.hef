# CELL-TS-03: Two parents with use timestamps 111 and 222 for the same unread child (file stamp 333).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/scmos -noprompt
snap internal
drc off
load input/p1
cellname timestamp child
load input/p2
cellname timestamp child
select top cell
expand
cellname timestamp child
