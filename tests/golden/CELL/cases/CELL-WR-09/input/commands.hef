# CELL-WR-09: Properties of every type saved with property compat true and false.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/scmos -noprompt
snap internal
load a
property s hello
property integer i 7
property dimension d 5 10
property double f 1.5
property FIXED_BBOX 0 0 10 20
property MASKHINTS_A 0 0 4 4
property compat true
save a1
property compat false
save a2
