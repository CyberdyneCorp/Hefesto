# CELL-PR-09: Bad recorded path with the cell in an addpath directory; then load -dereference.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/scmos -noprompt
snap internal
addpath input/lib
load input/top
cellname list allcells
load input/top2 -dereference
cellname list allcells
save top2_out
