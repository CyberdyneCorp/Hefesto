# CMDEDIT-HIER-06: 3-level hierarchy; flatten f1, -nolabels f2, -dotoplabels f3, -dobox f4, f1 again, -doinplace mid_0 (Q-CMDEDIT-31).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load leaf
box 0 0 10 10
paint metal1
box 5 5 5 5
label L
port make
save leaf
load mid
box 0 0 0 0
getcell leaf
box 2 2 2 2
label M
save mid
load top
box 0 0 0 0
getcell mid
box 50 0 50 0
getcell mid
box 1 1 1 1
label T
flatten f1
flatten -nolabels f2
flatten -dotoplabels f3
box 0 0 10 10
flatten -dobox f4
flatten f1
flatten -doinplace mid_0
writeall force
