# CMDEDIT-MISC-02: see no metal1; select visible; see allSame; select visible.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
box 0 0 10 10
paint metal1
box 0 0 5 5
paint poly
box 0 0 10 10
see no metal1
select visible
what -list
select clear
see allSame
select visible
what -list
