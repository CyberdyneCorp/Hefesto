# CMDEDIT-SEL-14: An instance selected; orient for every name, 180v and 9 (Q-CMDEDIT-62).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load leaf
box 0 0 10 10
paint metal1
save leaf
load a
box 0 0 0 0
getcell leaf
select cell leaf_0
orient 0
instance orientation leaf_0
