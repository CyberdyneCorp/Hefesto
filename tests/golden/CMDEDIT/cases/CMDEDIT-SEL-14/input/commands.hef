instance orientation leaf_0
orient 270v
instance orientation leaf_0
orient h
instance orientation leaf_0
orient 0h
instance orientation leaf_0
orient 90h
instance orientation leaf_0
orient 180h
instance orientation leaf_0
orient 270h
instance orientation leaf_0
orient N
instance orientation leaf_0
