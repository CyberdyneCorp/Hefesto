# CMDEDIT-PAINT-02: paint *,-metal2; paint -poly,metal1; paint metal1,connect; paint foo, labels, subcell.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load p1
box 0 0 10 10
paint *,-metal2
save p1
load p2
box 0 0 10 10
paint -poly,metal1
save p2
load p3
box 0 0 10 10
paint metal1,connect
paint foo
paint labels
paint subcell
save p3
