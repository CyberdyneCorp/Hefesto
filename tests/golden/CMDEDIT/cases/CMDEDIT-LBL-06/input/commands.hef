# CMDEDIT-LBL-06: findlabel OUT; findlabel -glob V*; findlabel x1/A 1.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load x
box 0 0 10 10
paint metal1
box 5 5 5 5
label A
save x
load a
box 50 0 50 0
getcell x
select cell x_0
identify x1
select clear
box 0 0 30 10
paint metal1
box 2 2 2 2
label OUT
box 12 2 12 2
label VDD
box 22 2 22 2
label VSS
findlabel OUT
box values
findlabel -glob V*
box values
findlabel x1/A 1
box values
