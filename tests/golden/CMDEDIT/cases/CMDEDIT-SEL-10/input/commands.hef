# CMDEDIT-SEL-10: move 5 7, move w, move to 0 0; a selection with child paint.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load m1
box 0 0 10 10
paint metal1
box 0 0 10 10
select area metal1
move 5 7
box values
move w
box values
move to 0 0
box values
save m1
load c
box 0 0 10 10
paint poly
save c
load top
box 20 0 20 0
getcell c
box 0 0 10 10
paint metal1
box -5 -5 40 15
select area
move 3 0
box values
writeall force
