# CMDEDIT-PAINT-12: A triangle, a pentagon, odd coordinates, too few coordinates and an odd coordinate count (Q-CMDEDIT-19).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load p1
polygon metal1 0 0 10 0 0 10
save p1
load p2
polygon metal1 0 0 20 0 20 10 10 20 0 10
save p2
load p3
polygon metal1 1 1 11 1 1 11
polygon metal1 0 0 10 0
polygon metal1 0 0 10 0 5
save p3
