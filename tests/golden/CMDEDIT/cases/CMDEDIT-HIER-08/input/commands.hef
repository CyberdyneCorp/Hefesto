# CMDEDIT-HIER-08: cellname list children/parents/allcells/topcells, exists, instance orientation -def, rename, writeable.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load a
box 0 0 10 10
paint metal1
save a
load top
box 0 0 0 0
getcell a
box 20 0 30 10
paint metal2
cellname list children top
cellname list parents a
cellname list allcells
cellname list topcells
cellname exists nosuch
instance orientation a_0 -def
cellname rename a b
cellname list allcells
cellname writeable b no
cellname writeable b
