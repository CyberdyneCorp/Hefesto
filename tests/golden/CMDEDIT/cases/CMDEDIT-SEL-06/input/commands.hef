# CMDEDIT-SEL-06: dnwell + nwell; select area dnwell; select intersection ~nwell.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tinydw -noprompt
load a
box 0 0 30 30
paint dnwell
box 10 10 40 40
paint nwell
box -5 -5 50 50
select area dnwell
select intersection ~nwell
what -list
select bbox
