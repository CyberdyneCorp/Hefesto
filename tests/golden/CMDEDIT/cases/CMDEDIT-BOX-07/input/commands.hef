# CMDEDIT-BOX-07: Edit a child placed rotated 90; root box 0 0 10 20; -edit queries and setter.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load child
box 0 0 10 10
paint metal1
save child
load top
box 0 0 0 0
getcell child 90
select cell child_0
edit
box values 0 0 10 20
box width -edit
box values -edit
box values 0 0 5 5 -edit
box values
