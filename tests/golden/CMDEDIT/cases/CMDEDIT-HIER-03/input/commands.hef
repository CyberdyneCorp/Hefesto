# CMDEDIT-HIER-03: dump blk with the box ll at 50 50; dump blk 90v.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load blk
box 0 0 10 10
paint metal1
box 5 5 5 5
label B
save blk
load top
box 50 50 50 50
dump blk
what -list
box 100 100 100 100
dump blk 90v
what -list
save top
