# CMDEDIT-SEL-16: Labels D0 and A[0][0] selected; array 4 1, 1 3, 2 2.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load l1
box 0 0 10 10
paint metal1
box 2 2 2 2
label D0
box 6 6 6 6
label {A[0][0]}
box 0 0 10 10
select area labels
array 4 1
save l1
load l2
box 0 0 10 10
paint metal1
box 2 2 2 2
label D0
box 6 6 6 6
label {A[0][0]}
box 0 0 10 10
select area labels
array 1 3
save l2
load l3
box 0 0 10 10
paint metal1
box 2 2 2 2
label D0
box 6 6 6 6
label {A[0][0]}
box 0 0 10 10
select area labels
array 2 2
save l3
