# CMDEDIT-PAINT-06: Zero-area box on a point label, on a label border and inside a rect label; erase labels (Q-CMDEDIT-20).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
box 0 0 30 30
paint metal1
box 5 5 5 5
label P
box 10 2 10 2
label E
box 10 10 20 20
label R
box 5 5 5 5
erase labels
save l1
box 10 15 10 15
erase labels
save l2
box 15 15 15 15
erase labels
save l3
