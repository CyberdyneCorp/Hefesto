# CMDEDIT-SEL-12: stretch e 10 of a wire end; stretch n 5 with abutting poly.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load s1
box 0 0 30 4
paint metal1
box 20 0 30 4
select area
stretch e 10
save s1
load s2
box 0 0 30 4
paint metal1
box 0 4 30 8
paint poly
box 0 0 30 4
select area metal1
stretch n 5
save s2
