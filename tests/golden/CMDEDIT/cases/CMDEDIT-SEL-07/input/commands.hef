# CMDEDIT-SEL-07: select no area, select s area, select simple labels, select foo bar (Q-CMDEDIT-60).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
box 0 0 10 10
paint metal1
box 5 5 5 5
label L
box 0 0 10 10
select no area
what -list
select s area
what -list
select simple labels
select foo bar
what -list
