# CMDEDIT-PAINT-08: Box 0 0 20 20 with a wire entering from each side; the 8 corner combinations; corner n s; a too-wide wire.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load cne
box 5 -10 8 0
paint metal1
box 0 0 20 20
corner n e
save cne
load cnw
box 5 -10 8 0
paint metal1
box 0 0 20 20
corner n w
save cnw
load cse
box 5 20 8 30
paint metal1
box 0 0 20 20
corner s e
save cse
load csw
box 5 20 8 30
paint metal1
box 0 0 20 20
corner s w
save csw
load cen
box -10 5 0 8
paint metal1
box 0 0 20 20
corner e n
save cen
load ces
box -10 5 0 8
paint metal1
box 0 0 20 20
corner e s
save ces
load cwn
box 20 5 30 8
paint metal1
box 0 0 20 20
corner w n
save cwn
load cws
box 20 5 30 8
paint metal1
box 0 0 20 20
corner w s
save cws
load cns
box 5 -10 8 0
paint metal1
box 0 0 20 20
corner n s
save cns
load cwide
box 0 -10 18 0
paint metal1
box 0 0 20 20
corner n e
save cwide
