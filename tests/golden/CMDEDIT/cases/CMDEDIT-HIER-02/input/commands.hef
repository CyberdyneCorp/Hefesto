# CMDEDIT-HIER-02: getcell pad child P; getcell c 90; getcell c child ur parent ll; each orientation keyword.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load a
load pad
box 0 0 20 20
paint metal1
box 10 10 10 10
label P
save pad
load c
box 0 0 10 20
paint metal1
box 5 5 5 5
label Q
save c
load top
box 0 0 0 0
getcell pad child P
box 100 0 100 0
getcell c 90
box 200 0 200 0
getcell c child ur parent ll
box 300 0 300 0
getcell c 0
box 340 0 340 0
getcell c 90
box 380 0 380 0
getcell c 180
box 420 0 420 0
getcell c 270
box 460 0 460 0
getcell c v
box 500 0 500 0
getcell c h
box 540 0 540 0
getcell c 90v
box 580 0 580 0
getcell c 90h
box values
save top
