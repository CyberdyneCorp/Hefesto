# UI-G-064: feedback add with a square and a triangle polygon; count; areas through find.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load input/c
box 0 0 4 4
feedback add "p" solid 0 0 10 0 10 10 0 10
feedback add "t" pale 0 0 10 0 0 10
feedback count
feedback find
box values
feedback find
box values
feedback find
box values
