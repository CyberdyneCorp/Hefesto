# UI-G-065: The UI-G-063/064 areas plus a quoted text, then feedback save f.txt.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load input/c
box 0 0 4 4
feedback add "a"
feedback add "b" medium 0 0 10 10
feedback add "c" outline 1 1
feedback add "p" solid 0 0 10 0 10 10 0 10
feedback add "t" pale 0 0 10 0 0 10
feedback add {say "hi"} dotted
feedback save f.txt
