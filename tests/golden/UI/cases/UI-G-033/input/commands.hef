# UI-G-033: Edit into leaf inside top (m2 edit); a second window on nand2; windowcaption in each window.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/tiny -noprompt
load input/c
load input/top
windowcaption
select cell leaf_0
edit
windowcaption
openwindow input/nand2
windowcaption
windownames all
