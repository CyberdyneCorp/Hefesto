file mkdir out
set status 0
schematic pdk sky130A
schematic open pdk/sky130A/libs.tech/xschem/sky130_tests/top.sch
if {[catch {schematic netlist out/top-flat.spice -flat -force}]} {set status 10}
schematic close -discard
schematic pdk sky130A
schematic open pdk/sky130A/libs.tech/xschem/sky130_tests/gain_stage.sch
if {[catch {schematic netlist out/gain_stage-flat.spice -flat -force}]} {set status 10}
schematic close -discard
quit $status
