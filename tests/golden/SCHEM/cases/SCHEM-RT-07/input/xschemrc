#
# rc file of the SCHEM golden captures (openspec/changes/m8-schematic design D16, task 3.2).
# Hefesto-authored; not a PDK file. tools/golden/authoring/schem_cases.py copies it into every
# SCHEM case as input/xschemrc, and the capture passes it to xschem with --rcfile.
#
# - With a PDK (environment PDK set by the capture runner or the case's run.sh), the PDK's own
#   xschemrc is sourced unchanged from the read-only data set mounted at $PDK_ROOT/$PDK.
# - Without one, the library path is xschem's system symbol folder.
# - The case's input folder is appended to the library path, so Hefesto-authored symbols resolve.
# - input/case.xschemrc, when the case has one, is sourced next (a case-specific setting).
# - xschem_execute_scripts is turned on last, so tcleval values are evaluated in every capture.
# - Netlists are written to <work>/out.

set hefesto_case_input [file dirname [file normalize [info script]]]
if {[info exists env(PDK)] && $env(PDK) ne {}} {
  source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
} else {
  set XSCHEM_LIBRARY_PATH ${XSCHEM_SHAREDIR}/xschem_library/devices
}
append XSCHEM_LIBRARY_PATH :$hefesto_case_input
if {[file exists $hefesto_case_input/case.xschemrc]} {
  source $hefesto_case_input/case.xschemrc
}
set netlist_dir [file join [file dirname $hefesto_case_input] out]
file mkdir $netlist_dir
set xschem_execute_scripts yes
