file mkdir out
set status 0
schematic pdk ihp-sg13g2
schematic open pdk/ihp-sg13g2/libs.tech/xschem/sg13g2_tests/dc_hbt_13g2.sch
if {[catch {schematic netlist out/dc_hbt_13g2.spice -force}]} {set status 10}
schematic close -discard
schematic pdk ihp-sg13g2
schematic open pdk/ihp-sg13g2/libs.tech/xschem/sg13g2_tests/ac_mim_cap.sch
if {[catch {schematic netlist out/ac_mim_cap.spice -force}]} {set status 10}
schematic close -discard
quit $status
