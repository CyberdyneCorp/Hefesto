x12 net1 net1 VCC VSS not W_N=0.5 L_N=1 W_P=1 L_P=1
x3 NET_A NET_A VCC VSS not W_N=0.5 L_N=1 W_P=1 L_P=1
x6 NET_E net1 VCC VSS not W_N=0.5 L_N=1 W_P=1 L_P=1
x7 NET_B NET_A VCC VSS not W_N=0.5 L_N=1 W_P=1 L_P=1
x4 net2 NET_B VCC VSS not W_N=0.5 L_N=1 W_P=1 L_P=1
x8 NET_F net2 VCC VSS not W_N=0.5 L_N=1 W_P=1 L_P=1
Vopt1 NET_D net1 0
.save i(vopt1)
Vopt2 NET_C net1 0
.save i(vopt2)
**.ends

