tech
    format 35
    oastest
end

planes
    active,a
    metal1,m1
    metal2,m2
    metal3,m3
end

types
    active  ndiffusion,ndiff
    active  pdiffusion,pdiff
    active  polysilicon,poly
    active  ntransistor,nfet
    metal1  metal1,m1
    metal2  metal2,m2
    metal3  metal3,m3
    active  pdcontact,pdc
    metal1  via1
    metal2  via2
end

contact
    pdc   pdiff  metal1
    via1  metal1 metal2
    via2  metal2 metal3
    stackable via1 via2
end

styles
    styletype mos
end

compose
    compose nfet poly ndiff
end

connect
    metal1 via1
    metal2 via1,via2
    metal3 via2
end

cifoutput
style gds
    scalefactor 10
    layer M1 metal1
        labels metal1
        calma 49 0
    layer M2 metal2
        labels metal2
        calma 51 0
end

cifinput
style gds
    scalefactor 10
    layer metal1 CMF
        labels CMF
    layer metal1 CMP
        labels CMP port
    layer metal1 CML
        labels CML text
    layer metal2 CMS
        labels CMS
    calma CMF 49 0
    calma CMP 49 16
    calma CML 49 5
    calma CMS 51 0
end

drc
end

extract
end
