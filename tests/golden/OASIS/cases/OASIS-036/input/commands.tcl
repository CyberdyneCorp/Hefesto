# OASIS-036: datestamp default, no and 1700000000: the timestamps read (0, 0, fixed 1700000000).
proc probe {script} {
    set code [catch {uplevel #0 $script} result]
    puts [list $code $result]
    flush stdout
}
addpath input
if {[catch {
proc rep {script} {
    set code [catch {uplevel #0 $script} result]
    set f [open report.txt a]
    puts $f [list $code $result]
    close $f
}
proc specrep {value} {
    set f [open report.txt a]
    puts $f [list 0 $value]
    close $f
}
probe {drc off}
probe {tech load input/oastest -noprompt}
probe {snap internal}
probe {gds read ds0}
rep {cellname timestamp ds0}
probe {gds datestamp no}
probe {gds read ds1}
rep {cellname timestamp ds1}
probe {gds datestamp 1700000000}
probe {gds read ds2}
rep {cellname timestamp ds2}
probe {load anchor}
probe {box 0 0 1 1}
probe {paint metal1}
rep {lsort [cellname list allcells]}
probe {writeall force}
} scriptError]} {
    puts [list script-error $scriptError]
    flush stdout
}
quit -noprompt
