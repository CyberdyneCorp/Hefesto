# DRC-NM-3: spacing m1 m1 3 touching_ok; two parallel 45-degree m1 wires 2 apart horizontally (1.4 perpendicular).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 2 2
splitpaint nw m1
box 0 2 2 4
splitpaint se m1
box 2 2 4 4
splitpaint nw m1
box 2 4 4 6
splitpaint se m1
box 4 4 6 6
splitpaint nw m1
box 4 6 6 8
splitpaint se m1
box 6 6 8 8
splitpaint nw m1
box 6 8 8 10
splitpaint se m1
box 4 -4 6 -2
splitpaint nw m1
box 4 -2 6 0
splitpaint se m1
box 6 -2 8 0
splitpaint nw m1
box 6 0 8 2
splitpaint se m1
box 8 0 10 2
splitpaint nw m1
box 8 2 10 4
splitpaint se m1
box 10 2 12 4
splitpaint nw m1
box 10 4 12 6
splitpaint se m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
