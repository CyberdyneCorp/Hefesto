# DRC-EDGE-4: edge4way m1 space 4 ~m1/metal1 ~m1/metal1 2 (cdist < dist); diagonal neighbors; euclidean on.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 12 11 20 20
paint m1
box 30 0 40 10
paint m1
box 43 13 50 20
paint m1
drc euclidean on
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
