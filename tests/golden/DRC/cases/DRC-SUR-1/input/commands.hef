# DRC-SUR-1: surround via m2 2 absence_ok; via surrounded by 1, via without m2, via surrounded by 2.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box -1 -1 5 5
paint m2
box 0 0 4 4
paint via
box 10 0 14 4
paint via
box 18 -2 26 6
paint m2
box 20 0 24 4
paint via
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
