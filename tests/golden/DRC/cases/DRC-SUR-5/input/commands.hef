# DRC-SUR-5: surround via m1 2 5 directional; surround 1 left/right and 3 top/bottom; and 1 everywhere.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box -1 -3 5 7
paint m1
box 0 0 4 4
paint via
box 19 -1 25 5
paint m1
box 20 0 24 4
paint via
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
