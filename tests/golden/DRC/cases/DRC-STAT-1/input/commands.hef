# DRC-STAT-1: sky130A: drc rulestats; check sky130_fd_sc_hd__inv_1; drc statistics.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/sky130A -noprompt
snap internal
scalegrid 1 2
drc off
drc euclidean on
snap internal
drc rulestats
load input/sky130_fd_sc_hd__inv_1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
drc statistics
