# DRC-EUC-2: spacing m1 m1 5 touching_illegal; m1 [0,10]^2 and [14,30]x[13,30]; CAP with euclidean off, then on.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 14 13 30 30
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
drc euclidean on
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
