# DRC-ENG-3: A layout at negative coordinates crossing x=0 and y=0 with violations.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box -10 -5 -1 5
paint m1
box 1 -5 10 5
paint m1
box -5 -20 5 -7
paint m1
box -60 -60 -58 -40
paint m1
box -100 20 -50 22
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
