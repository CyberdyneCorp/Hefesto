# DRC-OG-1: off_grid m1 5; m1 [3,10]x[0,10]; m1 [-8,-3]x[-7,2] (Q-DRC-9).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 3 0 10 10
paint m1
box -8 -7 -3 2
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
