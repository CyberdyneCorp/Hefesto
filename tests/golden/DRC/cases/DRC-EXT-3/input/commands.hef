# DRC-EXT-3: extend nfet poly 3 exclusive; gates 2 long followed by poly, and a full gate.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 20 2
paint ndiff
box 4 -3 6 5
paint poly
box 8 -3 10 5
paint poly
box 30 0 40 10
paint ndiff
box 34 -3 36 13
paint poly
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
