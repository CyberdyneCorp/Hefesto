# DRC-W-2: width poly 2 "w"; poly L-shape with a 1-wide step at the inner corner (corner extension).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 3
paint poly
box 0 0 3 10
paint poly
box 3 3 4 4
paint poly
box 20 0 30 3
paint poly
box 20 4 30 7
paint poly
box 20 0 23 7
paint poly
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
