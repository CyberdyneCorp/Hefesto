# DRC-AREA-1: area m1 20 4; isolated m1 4x4; m1 5x4.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 4 4
paint m1
box 10 0 15 4
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
