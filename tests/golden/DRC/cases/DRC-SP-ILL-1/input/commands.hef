# DRC-SP-ILL-1: spacing poly ndiff 1 touching_illegal; poly touching ndiff; poly 1 unit from ndiff.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 5 10
paint poly
box 5 0 10 10
paint ndiff
box 20 0 25 10
paint poly
box 26 0 30 10
paint ndiff
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
