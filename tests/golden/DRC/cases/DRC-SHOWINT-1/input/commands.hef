# DRC-SHOWINT-1: drc *showint 10 on a flat and on a hierarchical layout; the box after each.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load flat
box 0 0 10 10
paint m1
box 12 0 22 10
paint m1
select top cell
drc *showint 10
box values
load child
box 0 0 10 10
paint m1
load top
box 0 0 0 0
getcell child
box 15 0 25 10
paint m1
select top cell
drc *showint 10
box values
box 0 0 25 10
drc *showint 3
box values
box 40 40 50 50
drc *showint 3
box values
