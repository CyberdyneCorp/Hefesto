# DRC-FLAT-1: drc *flatcheck on the hierarchical design of DRC-ENG-4.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load child
box 0 0 10 10
paint m1
load top
box 0 0 0 0
getcell child
box 12 0 22 10
paint m1
box 40 0 42 10
paint m1
select top cell
drc *flatcheck
