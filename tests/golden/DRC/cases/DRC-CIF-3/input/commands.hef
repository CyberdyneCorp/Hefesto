# DRC-CIF-3: cifspacing NW PW 600 touching_illegal and cifspacing NW NW 600 touching_ok; *halo; CAP.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 1000 1000
paint nwell
box 1400 0 2400 1000
paint pwell
box 0 1300 1000 2000
paint nwell
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc *halo
