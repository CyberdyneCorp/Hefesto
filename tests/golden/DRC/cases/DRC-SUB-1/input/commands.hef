# DRC-SUB-1: Why texts with %d, %c and %a; drc why under units default, lambda, internal, microns.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 2 10
paint m1
box 5 0 7 10
paint m1
box 20 0 22 10
paint m2
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
select top cell
units default
drc why
units lambda
drc why
units internal
drc why
units microns
drc why
