# DRC-NMG-1: Two cells with 45-degree m1 whose overlap intersection is off the grid (why 5).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load a
box 0 0 10 10
splitpaint nw m1
load b
box 0 0 10 10
splitpaint ne m1
load top
box 0 0 0 0
getcell a
box 3 0 3 0
getcell b
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
