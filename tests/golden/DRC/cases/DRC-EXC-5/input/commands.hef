# DRC-EXC-5: exception SRAM spacing rule; hint in a subcell; violations in the parent interaction area inside and outside the child's hint.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load child
box 0 0 10 10
paint m1
box 30 0 40 10
paint m1
property MASKHINTS_SRAM 0 0 20 10
load top
box 0 0 0 0
getcell child
box 12 0 18 10
paint m1
box 42 0 50 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
