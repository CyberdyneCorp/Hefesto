# DRC-SCALE-2: DRC-SCALE-1 rules, then scalegrid 1 2; printrules, *halo and *stepsize before and after.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
drc printrules rules_1.txt
drc *halo
drc *stepsize
scalegrid 1 2
drc printrules rules_2.txt
drc *halo
drc *stepsize
