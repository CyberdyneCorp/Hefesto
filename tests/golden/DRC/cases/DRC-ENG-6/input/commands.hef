# DRC-ENG-6: DRC-ENG-5 with parent paint within the halo of the child (3 away).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load child
box 0 0 2 10
paint m1
load top
box 0 0 0 0
getcell child
box 5 0 15 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
box 0 0 3 10
drc why
