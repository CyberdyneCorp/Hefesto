# DRC-NM-1: spacing m1 m1 3 touching_ok; / split m1 tile [0,10]^2 (m1 lower-right) and m1 [-2,0]x[3,5].
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
splitpaint se m1
box -2 3 0 5
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
