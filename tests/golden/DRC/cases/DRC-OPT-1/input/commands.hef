# DRC-OPT-1: spacing poly ndiff 1 touching_illegal "A", width ndiff 3 "B"; poly abutting ndiff; printrules, CAP.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint ndiff
box 10 0 20 10
paint poly
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rules.txt
