# DRC-IGN-1: drc ignore spacing where the last-defined why contains spacing (Q-DRC-17); drc ignore; drc ignore none.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 12 0 22 10
paint m1
box 0 20 10 30
paint m2
box 12 20 22 30
paint m2
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
select top cell
drc why
drc ignore spacing
drc ignore
drc why
drc listall why
drc ignore none
drc ignore
drc why
drc ignore NONE
