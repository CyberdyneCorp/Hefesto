# DRC-RECT-1: rectangle via 10 odd; via 4x3 and 5x3.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 4 3
paint via
box 10 0 15 3
paint via
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
