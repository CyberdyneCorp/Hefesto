# DRC-RECT-2: rectangle via 3 any; via 5x2; non-rectangular via.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 5 2
paint via
box 10 0 14 2
paint via
box 10 0 12 4
paint via
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
