# DRC-SP-OK-1: spacing m1 m1 3 touching_ok; m1 [0,10]^2 and [12,20]x[0,10].
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 12 0 20 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
