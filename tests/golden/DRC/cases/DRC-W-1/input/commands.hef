# DRC-W-1: width poly 2 "w"; poly [0,1]x[0,10].
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 1 10
paint poly
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
