# DRC-MW-1: maxwidth m1 10 bend_ok; m1 12x12; m1 10x30.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 12 12
paint m1
box 20 0 30 30
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
