# DRC-WHY-2: drc list why and drc listall why with units microns and the default units.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 12 0 22 10
paint m1
box 40 0 42 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
select top cell
drc list why
drc listall why
units microns
drc list why
drc listall why
units lambda
drc listall why
units default
drc listall why
