# DRC-EUC-3: spacing m1c m1c 4 touching_illegal; m1c (VIA1 squares border 5) diagonal neighbors; euclidean on.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 20 20
paint m1c
box 22 23 42 43
paint m1c
box 60 0 80 20
paint m1c
box 83 23 103 43
paint m1c
box 120 0 140 20
paint m1c
box 141 21 161 41
paint m1c
box 200 0 220 20
paint m1c
box 222 0 242 20
paint m1c
drc euclidean on
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
