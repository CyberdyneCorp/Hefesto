# DRC-FIND-1: A top cell with 4 error tiles: drc find x5, drc find 3, drc find 9, drc find spacing, drc find width.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 12 0 22 10
paint m1
box 40 0 42 10
paint m1
box 60 0 62 10
paint m1
box 0 40 10 50
paint m1
box 11 40 20 50
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc find
box values
drc find
box values
drc find
box values
drc find
box values
drc find
box values
drc find 3
box values
drc find 9
box values
drc find spacing
box values
drc find width
box values
drc list find 2
box values
