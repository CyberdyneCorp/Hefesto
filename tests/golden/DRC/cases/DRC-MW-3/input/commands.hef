# DRC-MW-3: maxwidth m1 4 both; 3x10 bar and 5x10 bar.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 3 10
paint m1
box 10 0 15 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
