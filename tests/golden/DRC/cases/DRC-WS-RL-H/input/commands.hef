# DRC-WS-RL-H: DRC-WS-RL-V rotated 90 degrees (Q-DRC-7).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 40 12
paint m1
box 0 14 25 16
paint m1
box 0 100 40 112
paint m1
box 0 114 15 116
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
