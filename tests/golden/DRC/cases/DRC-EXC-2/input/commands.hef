# DRC-EXC-2: exception SRAM width rule; thin wires inside and outside the hint.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 2 10
paint m1
box 60 0 62 10
paint m1
property MASKHINTS_SRAM -10 -10 40 30
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
