# DRC-EUC-1: spacing m1 m1 3 touching_illegal; m1 [0,10]^2 and [12,20]^2; CAP with euclidean off, then on.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 12 12 20 20
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
drc euclidean on
drc euclidean
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
