# DRC-EUC-5: spacing m1 m1 5000 touching_illegal; diagonal neighbors at distance 5000 and just under (Q-DRC-20).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 3010 4010 3020 4020
paint m1
box 20000 0 20010 10
paint m1
box 23546 3545 23556 3555
paint m1
drc euclidean on
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
