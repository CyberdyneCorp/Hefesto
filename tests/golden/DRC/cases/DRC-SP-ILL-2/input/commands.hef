# DRC-SP-ILL-2: spacing m1c via 2 touching_illegal across planes (coincidence rule); coincident, 1 and 4 apart.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1c
box 0 0 10 10
paint via
box 20 0 30 10
paint m1c
box 31 0 35 10
paint via
box 50 0 60 10
paint m1c
box 64 0 70 10
paint via
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rules.txt
