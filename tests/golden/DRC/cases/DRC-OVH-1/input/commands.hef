# DRC-OVH-1: overhang poly nfet 2; endcap 1 on one side; poly absent on one side.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint ndiff
box 4 -1 6 12
paint poly
box 20 0 30 10
paint ndiff
box 24 0 26 12
paint poly
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
