# DRC-XOV-2: exact_overlap m1c; contacts exactly coincident in two cells.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load a
box 0 0 4 4
paint m1c
load b
box 0 0 4 4
paint m1c
load top
box 0 0 0 0
getcell a
box 0 0 0 0
getcell b
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
