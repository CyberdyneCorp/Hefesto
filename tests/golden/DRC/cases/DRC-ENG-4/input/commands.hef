# DRC-ENG-4: Parent paint 2 from child paint (spacing violation across the hierarchy).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load child
box 0 0 10 10
paint m1
load top
box 0 0 0 0
getcell child
box 12 0 22 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
