# DRC-MW-2: maxwidth poly 4 bend_illegal; L-shape.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 3
paint poly
box 0 0 3 10
paint poly
box 20 0 23 10
paint poly
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
