# DRC-NM-2: width m1 4 angles; a 45-degree m1 wire of perpendicular width about 2 (3/sqrt 2).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 3 3
splitpaint nw m1
box 0 3 3 6
splitpaint se m1
box 3 3 6 6
splitpaint nw m1
box 3 6 6 9
splitpaint se m1
box 6 6 9 9
splitpaint nw m1
box 6 9 9 12
splitpaint se m1
box 9 9 12 12
splitpaint nw m1
box 9 12 12 15
splitpaint se m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
