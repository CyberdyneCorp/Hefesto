# DRC-WS-1: widespacing m1 10 m1 4 touching_ok; block [0,12]^2 and line [14,30]x[0,2].
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 12 12
paint m1
box 14 0 30 2
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rules.txt
