# DRC-EXC-4: exception SRAM width rule; a horizontal 2-high wire with a hint touching or straddling its bottom or top edge (Q-DRC-11), one cell each.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load b
box 0 0 20 2
paint m1
property MASKHINTS_SRAM -10 -10 30 0
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save b
load t
box 0 0 20 2
paint m1
property MASKHINTS_SRAM -10 2 30 10
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save t
load bs
box 0 0 20 2
paint m1
property MASKHINTS_SRAM -10 -10 30 1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save bs
load ts
box 0 0 20 2
paint m1
property MASKHINTS_SRAM -10 1 30 10
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save ts
