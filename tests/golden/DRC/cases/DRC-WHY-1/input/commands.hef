# DRC-WHY-1: A box touching but not overlapping an error, then overlapping it.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 2 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
box 3 0 10 10
drc why
box 2 0 10 10
drc why
box -5 -5 0 0
drc why
