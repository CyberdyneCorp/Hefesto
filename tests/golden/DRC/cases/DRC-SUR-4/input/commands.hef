# DRC-SUR-4: surround m1c m1 1 exact_width (contact in metal) and surround via m2 1 exact_width (another plane, Q-DRC-18); exact and too-wide surrounds.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box -1 -1 21 21
paint m1
box 0 0 20 20
paint m1c
box 28 -1 51 21
paint m1
box 30 0 50 20
paint m1c
box 59 -1 65 5
paint m2
box 60 0 64 4
paint via
box 68 -1 75 5
paint m2
box 70 0 74 4
paint via
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
