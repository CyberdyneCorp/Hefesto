# DRC-OPT-2: width m1 2 "small", width m1 3 "big"; m1 1 wide.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 1 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rules.txt
