# DRC-EUC-4: spacing m1 m1 3 touching_illegal; a split m1 tile near the corner extension of m1; euclidean on.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 11 11 19 19
splitpaint sw m1
box 30 0 40 10
paint m1
box 41 11 49 19
splitpaint ne m1
drc euclidean on
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
