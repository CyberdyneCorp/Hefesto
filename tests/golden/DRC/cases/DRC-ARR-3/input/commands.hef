# DRC-ARR-3: A 2x1 array of an asymmetric cell placed with rotation 90.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load child
box 0 0 10 4
paint m1
box 0 0 4 10
paint m1
load top
box 0 0 0 0
getcell child 90
select cell child_0
box 0 0 12 10
array 2 1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
