# DRC-OVL-2: no_overlap pfet,nfet pfet,nfet; a transistor cell placed twice so the nfets overlap; CAP.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load fet
box 0 0 10 10
paint ndiff
box 4 -2 6 12
paint poly
load top
box 0 -2 0 -2
getcell fet
box 1 -2 1 -2
getcell fet
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
drc printrules rules.txt
