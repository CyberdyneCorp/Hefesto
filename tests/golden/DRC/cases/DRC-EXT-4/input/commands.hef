# DRC-EXT-4: extend m1 poly 3 (layers on different planes, trigger rules); printrules; CAP.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 4
paint poly
box 2 -1 8 5
paint m1
box 20 0 30 4
paint poly
box 22 -4 28 8
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rules.txt
