# DRC-ANG-2: angles m1 45; split tiles 4x3 and 3x3.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 4 3
splitpaint ne m1
box 10 0 13 3
splitpaint ne m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
