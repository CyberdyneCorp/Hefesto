# DRC-PDK-2: gf180mcuD: a row of abutted gf180mcu_fd_sc_mcu7t5v0 cells (inv_1, nand2_1, dffq_1); CAP.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/gf180mcuD -noprompt
snap internal
scalegrid 1 10
drc off
drc euclidean on
snap internal
load input/gf180mcu_fd_sc_mcu7t5v0__inv_1
load input/gf180mcu_fd_sc_mcu7t5v0__nand2_1
load input/gf180mcu_fd_sc_mcu7t5v0__dffq_1
load row
box 0 0 0 0
getcell gf180mcu_fd_sc_mcu7t5v0__inv_1
box 448 0 448 0
getcell gf180mcu_fd_sc_mcu7t5v0__nand2_1
box 1008 0 1008 0
getcell gf180mcu_fd_sc_mcu7t5v0__dffq_1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save row
