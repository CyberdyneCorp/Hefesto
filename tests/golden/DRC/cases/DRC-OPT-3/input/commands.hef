# DRC-OPT-3: edge4way space m1 2 m1 m1 2 "A" then edge space m1 3 m1 m1 3 "B" (Q-DRC-5); L-shaped m1 and notches.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 1
paint m1
box 0 0 1 10
paint m1
box 20 0 22 10
paint m1
box 20 8 30 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rules.txt
