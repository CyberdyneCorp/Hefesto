# DRC-AREA-2: area m1 20 4; a small m1 in a subcell abutting parent m1 (Q-DRC-8).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load child
box 0 0 4 4
paint m1
load top
box 0 0 0 0
getcell child
box 4 0 6 4
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
