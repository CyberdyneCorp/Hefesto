# DRC-EXC-1: exemption SRAM spacing rule; MASKHINTS_SRAM over half of the layout; violations inside and outside.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 12 0 22 10
paint m1
box 60 0 70 10
paint m1
box 72 0 82 10
paint m1
property MASKHINTS_SRAM -10 -10 40 30
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
