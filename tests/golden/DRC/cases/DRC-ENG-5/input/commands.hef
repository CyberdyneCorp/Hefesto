# DRC-ENG-5: A child with an internal width error far from parent paint; drc why over the copied error.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load child
box 0 0 2 10
paint m1
load top
box 0 0 0 0
getcell child
box 100 0 110 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
writeall force
box 0 0 3 10
drc why
box 1 1 2 2
drc why
box 50 0 60 10
drc why
