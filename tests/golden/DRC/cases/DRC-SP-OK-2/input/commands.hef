# DRC-SP-OK-2: spacing m1,m1c m1,m1c 3 touching_ok; m1 abutting m1c, and a second m1c 2 away.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 10 10
paint m1
box 10 0 30 20
paint m1c
box 32 0 52 20
paint m1c
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
