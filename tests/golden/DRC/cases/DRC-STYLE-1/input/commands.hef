# DRC-STYLE-1: style s variant A,B with variant-restricted rules; drc style sA and sB; printrules and CAP each.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
drc listall style
drc list style
load top
box 0 0 2 10
paint m1
box 20 0 23 10
paint m2
box 40 0 44 10
paint poly
drc style sA
drc list style
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
drc printrules rulesA.txt
drc style sB
drc list style
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rulesB.txt
drc style s
drc style x
