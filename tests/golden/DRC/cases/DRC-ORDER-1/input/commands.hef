# DRC-ORDER-1: width m1 3 "A" then edge4way space m1 3 m1 m1 3 "B"; printrules order for (space,m1); CAP on a 2-wide m1.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/drctest -noprompt
snap internal
drc off
load top
box 0 0 2 10
paint m1
select top cell
box grow center 100
drc check
drc catchup
drc listall why
drc list count total
save top
drc printrules rules.txt
