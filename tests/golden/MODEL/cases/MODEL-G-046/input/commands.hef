# MODEL-G-046: FIXED_BBOX, integer n, compat false; save; scalegrid 1 2; save.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load a
property FIXED_BBOX 0 0 100 200
property integer n 7
save a1
property compat false
save a2
scalegrid 1 2
save a3
