# MODEL-G-011: Child with nw/sw/se/ne triangles placed in 8 orientations, flattened.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load child
box 0 0 10 10
splitpaint nw metal1
box 20 0 30 10
splitpaint sw metal1
box 40 0 50 10
splitpaint se metal1
box 60 0 70 10
splitpaint ne metal1
save child
load top
box 0 0 0 0
getcell child 0
box 0 100 0 100
getcell child 90
box 0 200 0 200
getcell child 180
box 0 300 0 300
getcell child 270
box 0 400 0 400
getcell child v
box 0 500 0 500
getcell child h
box 0 600 0 600
getcell child 90v
box 0 700 0 700
getcell child 90h
save top
load top
flatten flat
load flat
save flat
