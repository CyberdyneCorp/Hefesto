# MODEL-G-057: Load a cell, undo; paint metal2, flatten -doinplace, undo (Q-MODEL-28).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load input/c
undo
save c1
load leaf
box 0 0 5 5
paint metal1
save leaf
load top
box 100 0 100 0
getcell leaf
box 0 0 4 4
paint metal2
flatten -doinplace leaf_0
undo
save top
