# MODEL-G-036: cellname rename a b with b existing; rename a vendor-GDS cell without and with -force.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load a
box 0 0 1 1
paint metal1
save a
load b
save b
cellname rename a b
load input/v
cellname rename v w
cellname rename v w -force
load w
property
save w
