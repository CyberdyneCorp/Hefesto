# MODEL-G-002: Two stacked squares (a); a square plus an offset square (b).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load a
box 0 0 10 10
paint metal1
box 0 10 10 20
paint metal1
save a
load b
box 0 0 10 10
paint metal1
box 5 10 15 20
paint metal1
save b
