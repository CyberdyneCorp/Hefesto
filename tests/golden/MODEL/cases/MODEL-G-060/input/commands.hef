# MODEL-G-060: top with a port and no flatten property, child c with the flatten property; flatten -nosubcircuits, -doproperty, -nosubcircuits -dotoplabels and -novendor (Q-MODEL-33: the first two are empty, the third has only top's label P).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load c
box 0 0 4 4
paint metal2
box 2 2 2 2
label Q
property flatten true
save c
load top
box 0 0 10 10
paint metal1
box 5 5 5 5
label P
port make
box 20 0 20 0
getcell c
save top
load top
flatten -nosubcircuits f1
load f1
save f1
load top
flatten -doproperty f2
load f2
save f2
load top
flatten -nosubcircuits -dotoplabels f3
load f3
save f3
load top
flatten -novendor f4
load f4
save f4
