# MODEL-G-009: Child (metal1 0 0 10 20, label N) placed with getcell in 8 orientations; flattened.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load child
box 0 0 10 20
paint metal1
box 5 10 5 10
label N
save child
load top
box 0 0 0 0
getcell child 0
box 40 0 40 0
getcell child 90
box 80 0 80 0
getcell child 180
box 120 0 120 0
getcell child 270
box 160 0 160 0
getcell child v
box 200 0 200 0
getcell child h
box 240 0 240 0
getcell child 90v
box 280 0 280 0
getcell child 90h
save top
load top
flatten flat
load flat
save flat
