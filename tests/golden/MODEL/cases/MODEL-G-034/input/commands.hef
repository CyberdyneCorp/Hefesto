# MODEL-G-034: 3-level hierarchy with labels and ports; flatten.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load leaf
box 0 0 10 10
paint metal1
box 5 5 5 5
label L
port make
save leaf
load mid
box 0 0 0 0
getcell leaf
box 2 2 2 2
label M
save mid
load top
box 0 0 0 0
getcell mid
box 50 0 50 0
getcell mid
box 1 1 1 1
label T
save top
load top
flatten flat
load flat
save flat
