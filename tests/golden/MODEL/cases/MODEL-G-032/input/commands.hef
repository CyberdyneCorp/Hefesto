# MODEL-G-032: instance lock inv_0; save (move/delete not authored).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load inv
box 0 0 10 10
paint metal1
save inv
load top
box 0 0 0 0
getcell inv
instance lock inv_0
save top
cellname list modified
