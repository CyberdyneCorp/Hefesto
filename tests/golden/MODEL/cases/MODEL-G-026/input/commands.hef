# MODEL-G-026: Save, then paint metal1 where metal1 already is; cellname list modified (Q-MODEL-23).
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load a
box 0 0 10 10
paint metal1
save a
cellname list modified
box 0 0 10 10
paint metal1
cellname list modified
