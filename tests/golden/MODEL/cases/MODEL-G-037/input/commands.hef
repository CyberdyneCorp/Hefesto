# MODEL-G-037: cellname delete inv while instantiated; then after deleting the parent.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load inv
box 0 0 10 10
paint metal1
save inv
load top
box 0 0 0 0
getcell inv
save top
load other
cellname delete inv
cellname delete top
cellname delete inv
cellname list allcells
