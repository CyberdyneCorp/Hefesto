# MODEL-G-052: metal1, via1 and metal2 in a run; select net from the metal1.
# Hefesto script (hefesto-cli --diagnostics=magic): the same commands.
tech load input/mt -noprompt
snap internal
load a
box 0 0 12 4
paint metal1
box 8 0 12 4
paint via1
box 8 0 30 4
paint metal2
box 1 1 1 1
select net
what -list
select bbox
