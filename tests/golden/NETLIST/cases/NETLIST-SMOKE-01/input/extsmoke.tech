tech
    format 35
    extsmoke
end

planes
    active,a
    metal1,m1
    metal2,m2
    metal3,m3
end

types
    active  ndiffusion,ndiff
    active  pdiffusion,pdiff
    active  polysilicon,poly
    active  ntransistor,nfet
    metal1  metal1,m1
    metal2  metal2,m2
    metal3  metal3,m3
    active  pdcontact,pdc
    metal1  via1
    metal2  via2
end

contact
    pdc   pdiff  metal1
    via1  metal1 metal2
    via2  metal2 metal3
    stackable via1 via2
end

styles
    styletype mos
end

compose
    compose nfet poly ndiff
end

connect
    metal1 via1
    metal2 via1,via2
    metal3 via2
end

cifoutput
end

cifinput
end

drc
end

extract
    style extsmoke
    lambda 1
    step 100
    sidehalo 0
    planeorder active 0
    planeorder metal1 1
    planeorder metal2 2
    planeorder metal3 3
    resist ndiff,pdiff,poly,pdc/a 1000
    resist metal1,pdc/m1,via1/m1 100
    resist metal2,via1/m2,via2/m2 50
    resist metal3,via2/m3 30
    areacap metal1 10
    areacap metal2 8
    areacap metal3 6
end
