#
tech
 format 35
 exttech
end
planes
 well,w
 active,a
 metal1,m1
 metal2,m2
 metal3,m3
end
types
 well pwell,pw
 well nwell,nw
 active ndiff,nd
 active pdiff,pd
 active psd
 active poly,p
 active nfet
 active pfet
 active ndc
 metal1 metal1,m1
 metal1 via
 metal2 metal2,m2
 metal3 metal3,m3
 metal3 comment
end
contact
 ndc ndiff metal1
 via metal1 metal2
end
styles
 styletype mos
end
compose
end
connect
 pwell psd
 ndiff ndc
 metal1 ndc,via
 metal2 via
 poly nfet,pfet
end
cifoutput
style lambda
 scalefactor 50
 layer M1 metal1
 calma 1 0
end
cifinput
end
drc
end
extract
 style s
 planeorder well 0
 planeorder active 1
 planeorder metal1 2
 planeorder metal2 3
 planeorder metal3 4
 sidehalo 1e10
 step 1e20
 device msubcircuit n nfet ndiff pwell VSUBS l>1e10 w<-1e10 a<=nan l=l+1e10 w=w-1e10 a=a
 device resistor r poly ndiff 1e30
end
