style plain
    scalefactor 10
    layer metal1 CMF
        labels CMF port
    layer metal2 CTX
        labels CTX text
    layer metal3 CIG
    layer metal3 CNL
    ignore CIG
    calma CMF 49 0
    calma CTX 50 0
    calma CIG 52 0
    calma CNL 54 0
style ign
    scalefactor 10
    layer metal1 CMF
        labels CMF port
    layer metal2 CTX
        labels CTX text
    layer metal3 CIG
    layer metal3 CNL
    ignore CIG
    calma CMF 49 0
    calma CTX 50 0
    calma CIG 52 0
    calma CNL 54 0
    options ignore-unknown-layer-labels
