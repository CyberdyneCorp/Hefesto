tech
    format 35
    maskfuzz
end

planes
    active,a
    metal1,m1
    metal2,m2
    metal3,m3
end

types
    active  ndiffusion,ndiff
    active  pdiffusion,pdiff
    active  polysilicon,poly
    active  ntransistor,nfet
    metal1  metal1,m1
    metal2  metal2,m2
    metal3  metal3,m3
    active  pdcontact,pdc
    metal1  via1
    metal2  via2
end

contact
    pdc   pdiff  metal1
    via1  metal1 metal2
    via2  metal2 metal3
    stackable via1 via2
end

styles
    styletype mos
end

compose
    compose nfet poly ndiff
end

connect
    metal1 via1
    metal2 via1,via2
    metal3 via2
end

# The fixed technology of fuzz_gds_reader and fuzz_cif_reader
# (tests/fuzz/; m5-mask-gds-cif design D21). Derived from
# tests/data/cif/masktest.tech. Every output operator's cost is bounded by
# the number of input tiles (no squares or slots), so a fuzz time-out is a
# real hang, not a large cut array.

cifoutput
style fuzz
    scalefactor 10
    layer CMF metal1,pdc,via1
        labels metal1
        calma 49 0
    layer CMS metal2,via1,via2
        labels metal2
        calma 51 0
    layer CMT metal3,via2
        grow 5
        shrink 5
        calma 62 0
    layer CPG poly,nfet
        labels poly
        calma 46 0
    templayer XAA ndiff,pdiff
        bloat-or nfet * 10
    layer CAA XAA,nfet,pdc
        calma 43 0
    layer CCA pdc
        shrink 10
        calma 48 0
    layer CVA via1
        and-not CMS
        or via2
        calma 50 0
end

cifinput
style fuzz
    scalefactor 10
    layer metal1 CMF
        labels CMF
    layer metal2 CMS
        labels CMS port
    layer metal3 CMT
    layer poly CPG
        labels CPG
    layer ndiff CAA
        and-not CPG
    layer nfet CPG
        and CAA
    layer pdc CCA
        grow 10
        and CAA
        and CMF
    layer via1 CVA
        shrink 5
        grow 5
    calma CMF 49 0
    calma CMF 49 5
    calma CMS 51 0
    calma CMS 51 *
    calma CMT 62 0
    calma CPG 46 0
    calma CAA 43 0
    calma CCA 48 0
    calma CVA 50 0
end

drc
end

extract
end
