# input.tech -- test technology of the mask/input unit tests
# (SPDX-License-Identifier: Apache-2.0). Planes well, active, metal1 and
# metal2; pc, ndc and m2c are contacts; nfet is a transistor type on the
# active plane. The cifoutput and cifinput sections are empty: each test
# appends its own (input_fixture.hpp).
tech
    format 35
    inputtest
end

planes
    well,w
    active,a
    metal1,m1
    metal2,m2
end

types
    well    nwell,nw
    active  polysilicon,poly
    active  ndiffusion,ndiff
    active  pdiffusion,pdiff
    active  ntransistor,nfet
    metal1  metal1,m1
    metal2  metal2,m2
    active  polycontact,pc
    active  ndcontact,ndc
    metal1  m2contact,m2c
end

contact
    pc   poly  metal1
    ndc  ndiff metal1
    m2c  metal1 metal2
end

styles
    styletype mos
    poly 1
end

compose
end

connect
    poly,pc      poly,pc
    m1,pc,ndc,m2c  m1,pc,ndc,m2c
end
