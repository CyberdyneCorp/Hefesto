 #include "cminfo.h"
 	NULL
@@ -473,7 +476,47 @@
     return (coreitf->dllitf_MIFbindCSCComplexToReal) (inModel, ckt) ;
 }
 #endif
+
+#else /* HEFESTO_STATIC_CODEMODELS */
 
+/* Hefesto patch 0002: built-in code models link against the core, which
+ * defines every function above except these; they behave as the coreInfo
+ * entries of cmexport.c (cp_getvar, no streams, the core allocator). */
+bool cm_getvar(char *name, enum cp_types type, void *retval, size_t rsize)
+{
+	return cp_getvar(name, type, retval, rsize);
+}
+
+FILE * cm_stream_out(void) {
+	return NULL;
+}
+
+FILE * cm_stream_in(void) {
+	return NULL;
+}
+
+FILE * cm_stream_err(void) {
+	return NULL;
+}
+
+void * malloc_pj(size_t s) {
+	return tmalloc(s);
+}
+
+void * calloc_pj(size_t s1, size_t s2) {
+	return tmalloc(s1 * s2);
+}
+
+void * realloc_pj(const void *ptr, size_t s) {
+	return trealloc(ptr, s);
+}
+
+void free_pj(const void *ptr) {
+	txfree(ptr);
+}
+
+#endif /* HEFESTO_STATIC_CODEMODELS */
