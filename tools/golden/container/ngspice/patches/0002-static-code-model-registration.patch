Subject: [PATCH 0002] Static code-model registration

Register the XSPICE code models compiled into the library when the device
table is created, and treat `codemodel <file>` of a built-in library as
already loaded. dlmain.c is compiled once, without the dll trampolines.
Active only with -DHEFESTO_STATIC_CODEMODELS. Justification: patches/series.

--- a/src/spicelib/devices/dev.c
+++ b/src/spicelib/devices/dev.c
@@ -73,7 +73,10 @@
 int add_udn(int,Evt_Udn_Info_t **);
 
 extern struct coreInfo_t  coreInfo; /* cmexport.c */
+#ifdef HEFESTO_STATIC_CODEMODELS
+#include "hefesto_static.h"
 #endif
+#endif
 
 
 #include "asrc/asrcitf.h"
@@ -262,6 +265,12 @@
 
     for (i = 0; i < DEVNUM; i++)
         DEVices[i] = static_devices[i]();
+
+#ifdef HEFESTO_STATIC_CODEMODELS
+    /* Hefesto patch 0002: the XSPICE code models are compiled into the
+     * library and registered here, before any spinit or deck is read. */
+    hefesto_cm_register_all();
+#endif
 }
 
 int num_devices(void)
@@ -375,6 +384,11 @@
     DEVicesfl[DEVNUM+i] = flag;
   }
   DEVNUM += n;
+#ifdef HEFESTO_STATIC_CODEMODELS
+  /* Hefesto patch 0002: called from spice_init_devices() before SIMinit()
+   * has set ft_sim, which then takes the device table itself. */
+  if (ft_sim)
+#endif
   relink();
   return 0;
 }
@@ -403,6 +417,12 @@
     Evt_Udn_Info_t **udns;
     funptr_t fetch;
 
+#ifdef HEFESTO_STATIC_CODEMODELS
+    /* Hefesto patch 0002: a built-in library is already registered. */
+    if (hefesto_cm_is_builtin(name))
+        return 0;
