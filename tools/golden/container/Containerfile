# Pinned, headless reference-tool image for golden capture
# (capability hefesto-testing-strategy, requirement "Golden compatibility suite";
# decision X-6; design D8). Built in CI by the manual/scheduled capture workflow,
# not on developer machines. Build context is tools/golden:
#
#   docker build -f tools/golden/container/Containerfile -t hefesto-golden:local tools/golden
#
# Every ARG default below must equal tools/golden/pins.toml (checked by
# tools/golden/tests/test_pins.py). Reproducibility:
#   - base image pinned by tag AND manifest-list digest;
#   - APT packages come from snapshot.debian.org at a fixed timestamp, so their
#     versions are fixed without listing each version;
#   - every tool is checked out at a full commit SHA, verified after checkout;
#   - no network access is needed at capture time (capture.py runs --network=none).
# "Headless" means no display at run time: Magic runs as `magic -dnull -noconsole`,
# netgen as `netgen -batch`, ngspice as `ngspice -b`, xschem with `-x --no_x`.
# Tcl/Tk and X11 *development* packages are still needed to compile the Tcl
# builds of Magic, netgen and xschem (the Tcl build of Magic is normative).
# The GUI cases of M4 (SCRIPT-GUI-*, m4-scripting design D16) run Magic's Tk
# wrapper (`magic -d X11 -noconsole`) under Xvfb: xvfb-run (package xvfb), xauth
# and the core X fonts Tk needs. case.toml `[reference] display = "xvfb"`
# selects it (goldenlib/refrunners.py); nothing else uses a display.
# KLayout runs in batch mode (`klayout -b`, QT_QPA_PLATFORM=offscreen) and gdstk from
# $HEFESTO_GDSTK_PYTHON (m6-lef-def-oasis design D18).
# --build-arg WITH_OPENGL=1 builds the magic-gl variant of the MISC-3D-* cases (last step below).
# --build-arg WITH_CAIRO=1 builds the magic-cairo variant of MISC-PLOT-12 and -13 (after it).

ARG BASE_IMAGE=docker.io/library/debian:trixie-20261020-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
FROM ${BASE_IMAGE}

ARG APT_SNAPSHOT=20261020T000000Z
ARG MAGIC_REPO=https://github.com/RTimothyEdwards/magic
ARG MAGIC_COMMIT=fc5daa9e2856b89a0a3056f296ded1fd4474e39e
ARG NETGEN_REPO=https://github.com/RTimothyEdwards/netgen
ARG NETGEN_COMMIT=93dcda14d36349d0b0ca63168d3cbbab20fe2ece
ARG NGSPICE_REPO=https://git.code.sf.net/p/ngspice/ngspice
ARG NGSPICE_COMMIT=a80f6e3e95d51534905b1f23410a951802666656
ARG NGSPICE_VERSION=47-hefesto2
ARG NGSPICE_STOCK_REPO=https://git.code.sf.net/p/ngspice/ngspice
ARG NGSPICE_STOCK_BRANCH=pre-master-48
ARG NGSPICE_STOCK_COMMIT=7aa4716494c01ac1d3120211316e898539a6cb4c
ARG OPENVAF_URL=https://fides.fe.uni-lj.si/openvaf/download/openvaf-reloaded-20260616-linux_x64.tar.gz
ARG OPENVAF_SHA256=bd4854a6e5b55f1c64a0b853d90216d1e3961d2f6d3ac572125597d28b867301
ARG XSCHEM_REPO=https://github.com/StefanSchippers/xschem
ARG XSCHEM_COMMIT=4142e6d6f1eb5cd0e271bb183f14202af374ce27
ARG WITH_XSCHEM=1
ARG KLAYOUT_DEB_VERSION=0.30.0-1+b1
ARG KLAYOUT_DEB_SHA256=421e473f7a1e0e4aa6b20dd1ca69b494c21e38308c38ad9259a7476cf4c3f272
ARG GDSTK_VERSION=1.0.2
ARG GDSTK_WHEEL_URL=https://files.pythonhosted.org/packages/cp313/g/gdstk/gdstk-1.0.2-cp313-cp313-manylinux_2_24_x86_64.manylinux_2_28_x86_64.whl
ARG GDSTK_WHEEL_SHA256=0429cc3eab8931415a040eec19875f3636453263603885ba881587c77837b41b

# QT_QPA_PLATFORM: KLayout runs in batch mode (-b) with no display; HEFESTO_GDSTK_PYTHON is the
# interpreter of the gdstk virtual environment below.
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LC_ALL=C \
    PREFIX=/opt/ref \
    QT_QPA_PLATFORM=offscreen \
    HEFESTO_GDSTK_PYTHON=/opt/ref/py/bin/python3 \
    PATH=/opt/ref/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# APT from a dated snapshot (versions frozen at APT_SNAPSHOT).
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s trixie main\n' "${APT_SNAPSHOT}" > /etc/apt/sources.list; \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s trixie-security main\n' "${APT_SNAPSHOT}" >> /etc/apt/sources.list; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends \
        ca-certificates git build-essential pkg-config m4 tcsh python3 \
        autoconf automake libtool bison flex \
        tcl8.6-dev tk8.6-dev libx11-dev libxext-dev zlib1g-dev libreadline-dev \
        libxpm-dev libcairo2-dev libxrender-dev libx11-xcb-dev libxcb1-dev \
        xvfb xauth xfonts-base gawk; \
    rm -rf /var/lib/apt/lists/*

# gawk is awk (openspec/changes/m8-schematic design D16, Q-SCHEM-18): the SCHEM goldens are captured with GNU
# Awk as the system awk. mawk stays installed but is not awk; the build fails if awk is not GNU Awk.
RUN set -eux; \
    update-alternatives --set awk /usr/bin/gawk; \
    awk --version | head -n 1 | grep -q '^GNU Awk'; \
    awk --version | head -n 1

# fetch_commit DIR REPO SHA [BRANCH]: shallow fetch by SHA when the server allows
# it (GitHub does), else clone the branch; then verify HEAD is exactly SHA.
RUN cat > /usr/local/bin/fetch_commit <<'EOF'
#!/bin/bash
set -euo pipefail
dir=$1 repo=$2 sha=$3 branch=${4:-}
git init -q "$dir"
git -C "$dir" remote add origin "$repo"
if ! git -C "$dir" fetch -q --depth 1 origin "$sha"; then
  git -C "$dir" fetch -q origin ${branch:+"$branch"}
fi
git -C "$dir" -c advice.detachedHead=false checkout -q "$sha"
test "$(git -C "$dir" rev-parse HEAD)" = "$sha"
EOF
RUN chmod +x /usr/local/bin/fetch_commit

# Magic 8.3.694, Tcl/Tk build without OpenGL/Cairo (X11 display only); run with
# -dnull -noconsole, or -d X11 -noconsole under Xvfb for the GUI cases.
RUN set -eux; \
    fetch_commit /opt/src/magic "${MAGIC_REPO}" "${MAGIC_COMMIT}"; \
    cd /opt/src/magic; \
    ./configure --prefix="${PREFIX}" --with-tcl=/usr/lib/tcl8.6 --with-tk=/usr/lib/tk8.6 \
        --with-opengl=no --with-cairo=no; \
    make -j"$(nproc)"; make install; \
    test -x "${PREFIX}/bin/magic"

# netgen (pinned by commit; tag 1.5.327 is a different commit and is not used).
RUN set -eux; \
    fetch_commit /opt/src/netgen "${NETGEN_REPO}" "${NETGEN_COMMIT}"; \
    cd /opt/src/netgen; \
    ./configure --prefix="${PREFIX}" --with-tcl=/usr/lib/tcl8.6 --with-tk=/usr/lib/tk8.6; \
    make -j"$(nproc)"; make install

# Stock ngspice (pre-master-48), batch binary and shared library (libngspice), no X: kept only for the
# --with-ngshared smoke test (Q-SIM-23 (a)); installed under /opt/ngspice-stock, off PATH.
RUN set -eux; \
    fetch_commit /opt/src/ngspice-stock "${NGSPICE_STOCK_REPO}" "${NGSPICE_STOCK_COMMIT}" "${NGSPICE_STOCK_BRANCH}"; \
    cd /opt/src/ngspice-stock; ./autogen.sh; \
    mkdir build-bin build-lib; \
    (cd build-bin && ../configure --prefix=/opt/ngspice-stock --with-x=no --enable-xspice --enable-cider \
        --enable-openmp=no --disable-debug && make -j"$(nproc)" && make install); \
    (cd build-lib && ../configure --prefix=/opt/ngspice-stock --with-x=no --enable-xspice --enable-cider \
        --enable-openmp=no --disable-debug --with-ngshared && make -j"$(nproc)" && make install); \
    /opt/ngspice-stock/bin/ngspice -v

# ngspice, the simulation reference (Q-SIM-23 (a); m9-lvs-simulation task 3.2): the engine's pin
# (ngspice-47) with the Hefesto patch series and feature table, built by the same CMake wrapper as
# libngspice-hefesto (container/ngspice/ is the build context's copy of third_party/ngspice/), as the
# `ngspice` executable and the shared library. Then OpenVAF-reloaded, a build-time tool that compiles
# the IHP Verilog-A sources to OSDI objects. build_ngspice.sh prints `hefesto-golden: ngspice <version>`.
COPY container/ngspice /opt/src/hefesto-ngspice
COPY container/build_ngspice.sh /opt/src/
RUN bash /opt/src/build_ngspice.sh /opt/src/hefesto-ngspice "${PREFIX}" "${NGSPICE_VERSION}" \
        "${OPENVAF_URL}" "${OPENVAF_SHA256}"

# xschem (schematic netlisting cases only), run headless with -x --no_x.
RUN set -eux; \
    if [ "${WITH_XSCHEM}" = "1" ]; then \
      fetch_commit /opt/src/xschem "${XSCHEM_REPO}" "${XSCHEM_COMMIT}"; \
      cd /opt/src/xschem; ./configure --prefix="${PREFIX}"; make -j"$(nproc)"; make install; \
    fi

# KLayout and gdstk, reference tools of the OASIS cases (m6-lef-def-oasis design D18). They run
# as separate programs (oasis-validate, the OASIS captures); Hefesto never links or calls them.
# KLayout is the Debian package of the APT snapshot, its .deb checked against the SHA-256 of the
# snapshot's Packages index. gdstk is a PyPI wheel checked by SHA-256 and installed, without
# dependencies, into a virtual environment that sees the snapshot's python3-numpy.
RUN set -eux; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    cd /tmp; \
    apt-get download "klayout=${KLAYOUT_DEB_VERSION}"; \
    deb="$(ls /tmp/klayout_*_amd64.deb)"; \
    echo "${KLAYOUT_DEB_SHA256}  ${deb}" | sha256sum -c -; \
    apt-get install -y --no-install-recommends "${deb}" python3-venv python3-numpy; \
    rm -f "${deb}"; rm -rf /var/lib/apt/lists/*; \
    wheel="/tmp/$(basename "${GDSTK_WHEEL_URL}")"; \
    python3 -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
        "${GDSTK_WHEEL_URL}" "${wheel}"; \
    echo "${GDSTK_WHEEL_SHA256}  ${wheel}" | sha256sum -c -; \
    python3 -m venv --system-site-packages "${PREFIX}/py"; \
    "${PREFIX}/py/bin/pip" install --no-deps --no-index --no-cache-dir "${wheel}"; \
    rm -f "${wheel}"; \
    klayout -v; \
    "${PREFIX}/py/bin/python3" -c 'import importlib.metadata as m, gdstk; print("gdstk", m.version("gdstk"))'; \
    test "$("${PREFIX}/py/bin/python3" -c 'import importlib.metadata as m; print(m.version("gdstk"))')" = "${GDSTK_VERSION}"

# magic-hash-harness: Magic's own utils/hash.c (unmodified, from the checkout
# above) behind tools/golden/harness/magic_hash/driver.c.
COPY harness/magic_hash /opt/src/magic-hash-harness
RUN set -eux; \
    cc -std=gnu99 -O1 -fsigned-char -w -DSUPPORT_DIRECT_MALLOC \
       -I/opt/src/magic-hash-harness/shim -I/opt/src/magic \
       -o "${PREFIX}/bin/magic-hash-harness" \
       /opt/src/magic-hash-harness/driver.c /opt/src/magic/utils/hash.c

# Magic's standalone extcheck (openspec/changes/m7-extraction design D15, task 2.2), same commit as
# `magic`: first from the Tcl build's tree, else from a Tcl-free configure; installed as
# ${PREFIX}/bin/extcheck only when it links and prints the usage text with exit status 1. If neither
# links at the pin (design R7) the image is still built and the manifest records why.
COPY container/build_extcheck.sh /opt/src/
RUN bash /opt/src/build_extcheck.sh /opt/src/magic "${MAGIC_REPO}" "${MAGIC_COMMIT}" "${PREFIX}"

# The image manifest (/opt/ref/share/hefesto-golden/manifest.json): the glibc version (Open Question 3
# of m7-extraction), the Magic commit and the extcheck build. goldenlib/refrunners.py records it in
# every provenance.json.
COPY container/write_manifest.sh /opt/src/
RUN bash /opt/src/write_manifest.sh "${MAGIC_COMMIT}" "${PREFIX}"

# The magic-gl variant (openspec/changes/m10-3d-view design D13, Open Question 3 (a)): the same Magic
# commit built again with OpenGL, against Mesa (llvmpipe through GLX), for the MISC-3D-* cases only;
# they run `magic -d OGL -noconsole` under xvfb-run with the GLX extension (goldenlib/refrunners.py).
#   docker build -f tools/golden/container/Containerfile --build-arg WITH_OPENGL=1 \
#       -t hefesto-golden-gl:local tools/golden
# The ARG is declared here, after every other step, so both images share the layers above. Magic's
# configure silently drops OpenGL when the GL headers are missing, so the build checks that -DOGL
# reached defs.mak, that Xvfb offers GLX on llvmpipe, and that a 3D window opens and answers `view`.
# The step also builds the polygon-recording shim of the geometry cases (gl_capture/gl_capture.c, task
# 12.4) as ${PREFIX}/lib/gl_capture.so and checks that, preloaded into the smoke run, it logs polygons,
# each with its display style named (none logged as `?`, the unresolved style of run 44965506225).
ARG WITH_OPENGL=0
COPY container/magic_gl_smoke.tcl gl_capture/gl_capture.c /opt/src/
RUN set -eux; \
    if [ "${WITH_OPENGL}" = "1" ]; then \
      apt-get -o Acquire::Check-Valid-Until=false update; \
      apt-get install -y --no-install-recommends \
          libgl-dev libglu1-mesa-dev libgl1-mesa-dri libglx-mesa0 mesa-utils; \
      rm -rf /var/lib/apt/lists/*; \
      fetch_commit /opt/src/magic-gl "${MAGIC_REPO}" "${MAGIC_COMMIT}"; \
      cd /opt/src/magic-gl; \
      ./configure --prefix="${PREFIX}" --with-tcl=/usr/lib/tcl8.6 --with-tk=/usr/lib/tk8.6 \
          --with-opengl --with-cairo=no; \
      grep -q -- '-DOGL' defs.mak; \
      grep -q -- '-DTHREE_D' defs.mak; \
      make -j"$(nproc)"; make install; \
      xvfb-run -a -s "-screen 0 1280x1024x24 +extension GLX" glxinfo -B | tee /tmp/glxinfo.txt; \
      grep -q 'llvmpipe' /tmp/glxinfo.txt; rm -f /tmp/glxinfo.txt; \
      cd /tmp; \
      timeout -s KILL 300 xvfb-run -a -s "-screen 0 1280x1024x24 +extension GLX" \
          "${PREFIX}/bin/magic" -d OGL -noconsole -norc /opt/src/magic_gl_smoke.tcl | tee /tmp/smoke.txt; \
      grep -qx 'magic-gl-smoke 0 {0.0 10.0 0.0}' /tmp/smoke.txt; rm -f /tmp/smoke.txt; \
      cc -std=gnu99 -O1 -Wall -Werror -shared -fPIC -o "${PREFIX}/lib/gl_capture.so" /opt/src/gl_capture.c -ldl -Wl,--no-as-needed -lGL; \
      HEFESTO_GL_CAPTURE=/tmp/gl.log timeout -s KILL 300 xvfb-run -a -s "-screen 0 1280x1024x24 +extension GLX" \
          env LD_PRELOAD="${PREFIX}/lib/gl_capture.so" \
          "${PREFIX}/bin/magic" -d OGL -noconsole -norc /opt/src/magic_gl_smoke.tcl | tee /tmp/smoke.txt; \
      grep -qx 'magic-gl-smoke 0 {0.0 10.0 0.0}' /tmp/smoke.txt; rm -f /tmp/smoke.txt; \
      head -n 1 /tmp/gl.log | grep -qx 'gl-capture 1'; grep -q '^poly ' /tmp/gl.log; \
      ! grep -q '^poly ? ' /tmp/gl.log; \
      grep -c '^poly ' /tmp/gl.log; rm -f /tmp/gl.log; \
    fi

# Plot files Magic reads from its system library path (openspec/changes/m10-plot-route task 2.1, Q-MISC-44):
# `plot postscript` copies magicps.pro from SysLibPath (". $CAD_ROOT/magic/sys ...", utils/paths.h) and
# writes `postscript_prolog_is_missing` without it; `plot pnm` reads the mos.7bit.* display styles and
# colour maps (the -dnull display loads the 7bit/std pair, the pnm `color`/`dstyle` lines the mraster
# pair). Magic's `make install` puts them in ${PREFIX}/lib/magic/sys (magic/Makefile, scmos/Makefile);
# the build fails here if one is missing.
RUN set -eux; \
    for f in magicps.pro mos.7bit.dstyle mos.7bit.std.cmap mos.7bit.mraster_dstyle mos.7bit.mraster.cmap; do \
      test -s "${PREFIX}/lib/magic/sys/${f}"; \
    done; \
    grep -q '%%BeginResource' "${PREFIX}/lib/magic/sys/magicps.pro"

# The magic-cairo variant (openspec/changes/m10-plot-route design D19, Q-MISC-52 (a)): the same Magic
# commit and configure line built again with Cairo, for MISC-PLOT-12 (`plot svg`) and MISC-PLOT-13 (the
# `plot help` list, which names `svg` only in a Cairo Tcl build); they run Magic's Tk wrapper on
# `magic -d XR -noconsole` under xvfb-run (case.toml `[reference] image = "magic-cairo"`).
#   docker build -f tools/golden/container/Containerfile --build-arg WITH_CAIRO=1 \
#       -t hefesto-golden-cairo:local tools/golden
# Declared after every other step (the magic-gl one included), so it shares their layers. libcairo2-dev
# is in the base package list. configure silently drops Cairo when it is not found, so the build checks
# that -DCAIRO and -DHAVE_LIBCAIRO reached defs.mak and that the smoke run writes an SVG file.
ARG WITH_CAIRO=0
COPY container/magic_cairo_smoke.tcl /opt/src/
RUN set -eux; \
    if [ "${WITH_CAIRO}" = "1" ]; then \
      fetch_commit /opt/src/magic-cairo "${MAGIC_REPO}" "${MAGIC_COMMIT}"; \
      cd /opt/src/magic-cairo; \
      ./configure --prefix="${PREFIX}" --with-tcl=/usr/lib/tcl8.6 --with-tk=/usr/lib/tk8.6 \
          --with-opengl=no --with-cairo; \
      grep -q -- '-DCAIRO' defs.mak; \
      grep -q -- '-DHAVE_LIBCAIRO' defs.mak; \
      make -j"$(nproc)"; make install; \
      cd /tmp; \
      timeout -s KILL 300 xvfb-run -a -s "-screen 0 1280x1024x24" \
          "${PREFIX}/bin/magic" -d XR -noconsole -norc /opt/src/magic_cairo_smoke.tcl | tee /tmp/smoke.txt; \
      grep -qx 'magic-cairo-smoke 1' /tmp/smoke.txt; rm -f /tmp/smoke.txt; \
      grep -q '<svg' /tmp/magic_cairo_smoke.svg; rm -f /tmp/magic_cairo_smoke.svg; \
    fi

LABEL org.opencontainers.image.title="hefesto-golden" \
      org.opencontainers.image.description="Pinned headless Magic/netgen/ngspice/xschem/KLayout/gdstk for Hefesto golden capture" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.hefesto.magic.commit="${MAGIC_COMMIT}" \
      io.hefesto.magic.opengl="${WITH_OPENGL}" \
      io.hefesto.magic.cairo="${WITH_CAIRO}" \
      io.hefesto.netgen.commit="${NETGEN_COMMIT}" \
      io.hefesto.ngspice.commit="${NGSPICE_COMMIT}" \
      io.hefesto.ngspice.version="${NGSPICE_VERSION}" \
      io.hefesto.xschem.commit="${XSCHEM_COMMIT}" \
      io.hefesto.klayout.deb="${KLAYOUT_DEB_VERSION}" \
      io.hefesto.gdstk.version="${GDSTK_VERSION}" \
      io.hefesto.apt.snapshot="${APT_SNAPSHOT}"

WORKDIR /work
