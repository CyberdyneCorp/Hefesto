# The bundled plot data files (assets/plot/: Magic's scmos mos.7bit display
# and colour files, unmodified; plot-output "Platform mechanism of plot
# output", Q-MISC-44), embedded as raw string literals so every platform,
# iPadOS included, has them without an install path. The generated file is
# rewritten only when its content changes.
function(hefesto_plot_embed_assets asset_dir out_cpp)
  set(_files mos.7bit.dstyle mos.7bit.std.cmap mos.7bit.mraster.cmap mos.7bit.mraster_dstyle)
  set(_arrays "")
  set(_rows "")
  set(_index 0)
  foreach(_file IN LISTS _files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${asset_dir}/${_file}")
    file(READ "${asset_dir}/${_file}" _text)
    string(FIND "${_text}" ")HEFESTOPLOT\"" _clash)
    if(NOT _clash EQUAL -1)
      message(FATAL_ERROR "assets/plot/${_file} contains the raw-string delimiter")
    endif()
    string(APPEND _arrays "constexpr char kFile${_index}[] = R\"HEFESTOPLOT(${_text})HEFESTOPLOT\";\n")
    string(APPEND _rows "    {\"${_file}\", std::string_view{kFile${_index}, sizeof(kFile${_index}) - 1}},\n")
    math(EXPR _index "${_index} + 1")
  endforeach()
  set(_content "// Generated by src/core/src/plot/tech/sources.cmake from assets/plot/. Do not edit.\n\n")
  string(APPEND _content "#include <optional>\n#include <string_view>\n#include <utility>\n\n")
  string(APPEND _content "#include \"plot/tech/reader.hpp\"\n\n")
  string(APPEND _content "namespace hefesto::plot::detail {\n\nnamespace {\n\n${_arrays}\n")
  string(APPEND _content "constexpr std::pair<std::string_view, std::string_view> kFiles[] = {\n${_rows}};\n\n")
  string(APPEND _content "}  // namespace\n\n")
  string(APPEND _content "std::optional<std::string_view> bundled_file(std::string_view name) noexcept {\n")
  string(APPEND _content "  for (const auto& [file, text] : kFiles) {\n    if (file == name) {\n      return text;\n    }\n  }\n")
  string(APPEND _content "  return std::nullopt;\n}\n\n}  // namespace hefesto::plot::detail\n")
  file(WRITE "${out_cpp}.new" "${_content}")
  file(COPY_FILE "${out_cpp}.new" "${out_cpp}" ONLY_IF_DIFFERENT)
  file(REMOVE "${out_cpp}.new")
endfunction()

hefesto_plot_embed_assets("${PROJECT_SOURCE_DIR}/assets/plot" "${CMAKE_CURRENT_BINARY_DIR}/generated/plot_bundled_files.cpp")
target_sources(hefesto_core PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/plot_bundled_files.cpp")
