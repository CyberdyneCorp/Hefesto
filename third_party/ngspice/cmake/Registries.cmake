#
# Writes the two generated registry sources of libngspice-hefesto:
#   hefesto_cm_registry.c     the built-in code models (patch 0002), from
#                             NGSPICE_CM_FUNCTIONS (cmake/CodeModels.cmake);
#   hefesto_osdi_builtins.c   the built-in OSDI modules (patch 0001), from
#                             HEFESTO_NGSPICE_OSDI_MODULES: none until task 5.2
#                             compiles the IHP modules with the pinned OpenVAF.

function(ngspice_write_registries out_dir)
  string(JSON lib_count LENGTH "${_ng_pin}" code_models)
  math(EXPR last "${lib_count} - 1")
  set(libraries "")
  foreach(i RANGE ${last})
    string(JSON lib GET "${_ng_pin}" code_models ${i})
    string(APPEND libraries "    \"${lib}\",\n")
  endforeach()
  set(externs "")
  set(entries "")
  foreach(fn IN LISTS NGSPICE_CM_FUNCTIONS)
    string(APPEND externs "extern SPICEdev ${fn}_info;\n")
    string(APPEND entries "    &${fn}_info,\n")
  endforeach()
  list(LENGTH NGSPICE_CM_FUNCTIONS model_count)

  file(CONFIGURE OUTPUT "${out_dir}/hefesto_cm_registry.c" @ONLY CONTENT [[
/* GENERATED by third_party/ngspice/cmake/Registries.cmake; do not edit.
 * SPDX-License-Identifier: Apache-2.0
 * Copyright 2026 The Hefesto Authors
 *
 * The XSPICE code models compiled into libngspice-hefesto (Hefesto patch
 * 0002), in the order ngspice's spinit loads their libraries. */
#include "ngspice/ngspice.h"
#include "ngspice/devdefs.h"

#include "hefesto_static.h"

#include <string.h>

int add_device(int n, SPICEdev **devs, int flag); /* spicelib/devices/dev.c */

@externs@
static SPICEdev *builtin_models[@model_count@] = {
@entries@};

static const char *const builtin_libraries[] = {
@libraries@};

void hefesto_cm_register_all(void)
{
    /* flag 1: a code model (DEVicesfl), as load_opus() registers them. */
    add_device((int) (sizeof builtin_models / sizeof builtin_models[0]), builtin_models, 1);
}

int hefesto_cm_is_builtin(const char *path)
{
    char name[256];
    if (!hefesto_module_name(path, ".cm", name, sizeof name))
        return 0;
    for (size_t i = 0; i < sizeof builtin_libraries / sizeof builtin_libraries[0]; i++) {
        if (strcmp(builtin_libraries[i], name) == 0)
            return 1;
    }
    return 0;
}
]])

  # OSDI: one HefestoOsdiModule per entry of HEFESTO_NGSPICE_OSDI_MODULES (task 5.2).
  file(CONFIGURE OUTPUT "${out_dir}/hefesto_osdi_builtins.c" @ONLY CONTENT [[
/* GENERATED by third_party/ngspice/cmake/Registries.cmake; do not edit.
 * SPDX-License-Identifier: Apache-2.0
 * Copyright 2026 The Hefesto Authors
 *
 * The OSDI modules compiled into libngspice-hefesto (Hefesto patch 0001).
 * None yet: task 5.2 adds the IHP modules compiled with the pinned OpenVAF. */
#include "hefesto_static.h"

const HefestoOsdiModule hefesto_osdi_modules[1] = {{0, 0, 0}};
const size_t hefesto_osdi_module_count = 0;
]])
endfunction()
