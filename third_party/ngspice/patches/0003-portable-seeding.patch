Subject: [PATCH 0003] Portable generator seeding

Seed the Tausworthe/LCG states from SplitMix64 of the seed instead of the C
library's rand(), whose sequence differs between platforms (capability
simulation-monte-carlo, "Portable random numbers"). Justification:
patches/series.

--- a/src/maths/misc/randnumb.c
+++ b/src/maths/misc/randnumb.c
@@ -67,7 +67,26 @@
 void rgauss(double* py1, double* py2);
 static bool seedinfo = FALSE;
 
+/* Hefesto patch 0003: the seed of the next TausSeed(), set by PortableSeed()
+ * where the stock code calls srand(). */
+static unsigned long long portable_seed = 1;
 
+void PortableSeed(unsigned int seed)
+{
+   portable_seed = seed;
+}
+
+/* v_t of the Hefesto random stream (SplitMix64; capability simulation-sweeps,
+   Requirement "Design of experiments") for seed s. */
+static unsigned long long SplitMix64(unsigned long long s, unsigned int t)
+{
+   unsigned long long z = s + (unsigned long long)(t + 1) * 0x9E3779B97F4A7C15ULL;
+   z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+   z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+   return z ^ (z >> 31);
+}
+
+
 /* Check if a seed has been set by the command 'set rndseed=value'
    in spinit, .spiceinit or in a .control section
    with integer value > 0. If available, call srand(value).
@@ -81,7 +100,7 @@
 /*   printf("Enter checkseed()\n"); */
    if (cp_getvar("rndseed", CP_NUM, &newseed, 0)) {
       if ((newseed > 0) && (oldseed != newseed)) {
-         srand((unsigned int)newseed);
+         PortableSeed((unsigned int)newseed);
          TausSeed();
          if (oldseed > 0) /* no printout upon start-up */
              printf("Seed value for random number generator is set to %d\n", newseed);
@@ -102,17 +121,18 @@
