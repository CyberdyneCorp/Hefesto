    /* The Tausworthe initial states should be greater than 128.
       We restrict the values up to 32767. 
-      Here we use the standard random functions srand, called in main.c
-      upon ngspice startup or later in fcn checkseed(),
-      rand() and the maximum return value RAND_MAX*/
-   CombState1 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
-   CombState2 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
-   CombState3 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
-   CombState4 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
-   CombState5 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
-   CombState6 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
-   CombState7 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
-   CombState8 = (unsigned int)((double)rand()/(double)RAND_MAX * 32638.) + 129;
+      Hefesto patch 0003: the states come from the seed of PortableSeed()
+      through SplitMix64 instead of rand(), whose sequence differs between
+      C libraries: state_k = 129 + (v_{k-1}(s) mod 32639), k = 1 ... 8
+      (capability simulation-monte-carlo, "Portable random numbers"). */
+   CombState1 = 129 + (unsigned int)(SplitMix64(portable_seed, 0) % 32639ULL);
+   CombState2 = 129 + (unsigned int)(SplitMix64(portable_seed, 1) % 32639ULL);
+   CombState3 = 129 + (unsigned int)(SplitMix64(portable_seed, 2) % 32639ULL);
+   CombState4 = 129 + (unsigned int)(SplitMix64(portable_seed, 3) % 32639ULL);
+   CombState5 = 129 + (unsigned int)(SplitMix64(portable_seed, 4) % 32639ULL);
+   CombState6 = 129 + (unsigned int)(SplitMix64(portable_seed, 5) % 32639ULL);
+   CombState7 = 129 + (unsigned int)(SplitMix64(portable_seed, 6) % 32639ULL);
+   CombState8 = 129 + (unsigned int)(SplitMix64(portable_seed, 7) % 32639ULL);
 
 #ifdef HVDEBUG
